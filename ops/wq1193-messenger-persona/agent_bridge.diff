+# ── Persona (wq#1193) ─────────────────────────────────────────────────────────
+# wq#1176 item 4, "persona facts flow both ways". Lumen's canonical self-facts
+# live in lumen_state (subject lumen-persona), shared with the streamer, so what
+# he claimed on stream is what he claims here and the reverse. Both wrappers are
+# thin on purpose — the store read, the extraction policy and the guardrails all
+# live in lumen_persona_bridge.py. Fail-open, like every other prompt augment
+# above: a persona problem must never cost a reply.
+
+def _with_persona(system: str) -> str:
+    """Append the canonical self-facts. Sits BELOW the worklog and ABOVE the
+    telemetry block so the volatile 60s telemetry stays in the tail position."""
+    try:
+        import lumen_persona_bridge
+        return lumen_persona_bridge.with_persona(system)
+    except Exception as _e:
+        log.warning(f"persona recall unavailable: {_e}")
+        return system
+
+
+def _note_persona(reply: str) -> None:
+    """Mine a reply Lumen just gave HERE for durable self-facts, so the streamer
+    knows them next turn. Returns immediately; extraction runs off the response
+    path and refuses anything carrying fleet infrastructure."""
+    try:
+        import lumen_persona_bridge
+        lumen_persona_bridge.note_reply(reply)
+    except Exception as _e:
+        log.warning(f"persona ingest unavailable: {_e}")
+
