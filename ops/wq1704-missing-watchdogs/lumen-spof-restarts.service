[Unit]
Description=SPOF watch: NRestarts delta on Restart= daemons (wq#1704, atlas 5.7)
After=network.target
OnFailure=ntfy-onfailure@%n.service

[Service]
Type=oneshot
User=lumen
ExecStart=/usr/bin/python3 /home/lumen/bin/fleet-spof-watch restarts
ExecStartPost=-/home/lumen/bin/lumen-cron-stamp %n
TimeoutStartSec=180
