[Unit]
Description=SPOF watch: dead-man for vault HA + backup timers (wq#1704, atlas 5.4)
After=network.target
OnFailure=ntfy-onfailure@%n.service

[Service]
Type=oneshot
User=lumen
ExecStart=/usr/bin/python3 /home/lumen/bin/fleet-spof-watch timers
ExecStartPost=-/home/lumen/bin/lumen-cron-stamp %n
TimeoutStartSec=120
