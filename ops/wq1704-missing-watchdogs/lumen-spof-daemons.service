[Unit]
Description=SPOF watch: alert-path daemons with no external check (wq#1704, atlas 5.5)
After=network.target
OnFailure=ntfy-onfailure@%n.service

[Service]
Type=oneshot
User=lumen
ExecStart=/usr/bin/python3 /home/lumen/bin/fleet-spof-watch daemons
ExecStartPost=-/home/lumen/bin/lumen-cron-stamp %n
TimeoutStartSec=120
