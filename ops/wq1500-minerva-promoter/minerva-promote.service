[Unit]
Description=Backfill factory-parked minerva proposals (deploy_ready/planned/staged) into wq tickets (wq#1500)
Documentation=file:///home/lumen/foreman/ops/wq1500-minerva-promoter/README.md
After=minerva-factory.service

[Service]
Type=oneshot
User=lumen
Group=lumen
WorkingDirectory=/home/lumen/minerva
Environment=WQ_AGENT=minerva-promoter
# minerva_promote.py is owned by the minerva repo (live tree, symlinked as /home/lumen/bin/minerva-promote).
# `run 200` is idempotent: wq_ticket column -> minerva_proposal=<id> marker -> wq title dedup.
ExecStart=/usr/bin/python3 /home/lumen/minerva/minerva_promote.py run 200
ExecStartPost=-/home/lumen/bin/lumen-cron-stamp %n
TimeoutStartSec=900
StandardOutput=journal
StandardError=journal
SyslogIdentifier=minerva-promote
