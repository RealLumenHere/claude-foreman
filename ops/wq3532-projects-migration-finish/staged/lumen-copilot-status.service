[Unit]
Description=Lumen Copilot build-state panel (read-only)
After=network.target

[Service]
Type=simple
User=lumen
Environment=TZ=America/Los_Angeles
WorkingDirectory=/scratch/fleet/projects/lumen-copilot/status
ExecStart=/usr/bin/python3 -m uvicorn app:app --host 0.0.0.0 --port 8145
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
