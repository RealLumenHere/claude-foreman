# wq#2500 — copy to /home/sia/services/rsshub/.env, chmod 0600, fill in for real.
# NEVER commit the filled-in version. NEVER put the token in a URL or compose text.
#
# The trending route (github/trending/daily/python) works fully unauthenticated at
# the poll rate Miniflux uses (a few times/day) — GITHUB_ACCESS_TOKEN is optional
# and only raises the rate ceiling for the release route. Leave unset until Frank
# mints a PAT (FRANK-PHYSICAL, queued separately, not a gate on this bundle).
GITHUB_ACCESS_TOKEN=

# RSSHub's own cache-key salt; any random value, not secret, but keep instance-local
# so cache keys don't collide with anyone else's public RSSHub deploy.
NODE_NAME=lumen-fleet-sia
