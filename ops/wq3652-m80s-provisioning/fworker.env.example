# fworker.env.example — EnvironmentFile template for fworker-sandbox@.service
# (wq#3652 step 7: point fworker env at Lumen LiteLLM+wq).
#
# provision-fworker.sh installs a copy of this file as /var/fworker/fworker.env
# (0600 fworker:fworker). This checked-in copy is the template, not the live
# secret-bearing file — FOREMAN_LITELLM_KEY_FILE below names a path, the key
# itself is minted and copied in separately (see README.md's Claude-auth-
# migration step, which is the same class of action: a credential only Frank can
# mint on his own account, queued as a physical task per instinct 3, never run
# from this BUILD worker's sandbox).

# fworker's own checkout (step 4: owns /var/fworker only; ProtectHome=yes in the
# unit blocks /home/lumen entirely, so this cannot point at the shared paths the
# defaults in harness/fworker.py:97-115 use on Lumen itself).
FOREMAN_ROOT=/var/fworker/foreman
FOREMAN_WORKTREES_ROOT=/var/fworker/worktrees
FOREMAN_EVENTS_DIR=/var/fworker/foreman/events
FOREMAN_RUNS_ROOT=/var/fworker/foreman/_runs

# LiteLLM is an HTTP gateway (unlike wq's local sqlite below) so it is pointed
# straight at Lumen's tailnet address — confirm this is still current via
# `lumen_state.py current lumen tailscale_ip` before deploying (verified
# 100.117.66.102 since 2026-06-07 at authoring time; instinct 1: never assume a
# fleet IP hasn't changed).
FOREMAN_LITELLM_BASE_URL=http://100.117.66.102:4000
FOREMAN_LITELLM_KEY_FILE=/var/fworker/.secrets/litellm.key

# wq has no remote-DB mode (/home/lumen/bin/wq:101 — WQ_DB is a local sqlite
# path), so fworker never talks to it directly: FOREMAN_WQ_BIN points at the
# ssh-wrapped shim in this directory, not the real CLI.
FOREMAN_WQ_BIN=/var/fworker/bin/wq-remote
LUMEN_SSH_TARGET=lumen@100.117.66.102
