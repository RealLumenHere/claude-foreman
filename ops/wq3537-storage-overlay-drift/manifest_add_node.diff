diff --git a/test_add_node_overlay.py b/test_add_node_overlay.py
new file mode 100644
index 0000000..036c455
--- /dev/null
+++ b/test_add_node_overlay.py
@@ -0,0 +1,85 @@
+"""wq#3537: manifest_add_node must write a manifest the overlay already agrees with.
+
+The bug: add stamped meta.updated, a key the overlay owns wholesale, so
+apply_overlay.diff_keys() saw drift after every node add and storage_probe's
+assert_overlay_sync() escalated manifest:overlay-drift until someone ran
+`apply_overlay.py --apply` by hand (horus, 2026-10-07).
+
+Each test asserts the written manifest is a fixed point of apply_overlay.build(),
+which is exactly the condition assert_overlay_sync() checks.
+"""
+import os
+import sys
+
+import yaml
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+sys.path.insert(0, HERE)
+import apply_overlay as ao
+import manifest_add_node as mad
+
+
+def _drift(man, ov):
+    return list(ao.diff_keys(man, ao.build(ov, man)))
+
+
+OV = {
+    "meta": {"updated": "2026-08-13", "owner": "lumen"},
+    "node_overrides": {"isis": {"max_watts": 145}},
+}
+
+
+def _synced_manifest(ov=OV):
+    man = {"meta": {"overlay_applied": "2026-09-28T03:25:19Z"},
+           "nodes": {"isis": {"max_watts": 130, "mounts": ["/"]},
+                     "anubis": {"max_watts": 90}}}
+    man = ao.build(ov, man)
+    assert _drift(man, ov) == []
+    return man
+
+
+def test_fresh_add_leaves_no_drift():
+    man = mad.add_entry(_synced_manifest(), OV, "horus", {"max_watts": 60})
+    assert _drift(man, OV) == []
+    assert man["meta"]["updated"] == "2026-08-13"
+    assert man["nodes"]["horus"] == {"max_watts": 60}
+
+
+def test_apply_stamp_survives_add():
+    man = mad.add_entry(_synced_manifest(), OV, "horus", {})
+    assert man["meta"]["overlay_applied"] == "2026-09-28T03:25:19Z"
+
+
+def test_replace_keeps_overlay_calibration():
+    # --replace re-surveys isis; the fresh entry carries the survey default,
+    # the overlay's aq#506 recalibration must still win.
+    man = mad.add_entry(_synced_manifest(), OV, "isis", {"max_watts": 130, "mounts": ["/", "/data"]})
+    assert man["nodes"]["isis"] == {"max_watts": 145, "mounts": ["/", "/data"]}
+    assert _drift(man, OV) == []
+
+
+def test_provision_pending_dropped_and_input_untouched():
+    base = _synced_manifest()
+    entry = {"max_watts": 60, "provision_pending": True}
+    man = mad.add_entry(base, OV, "horus", entry)
+    assert man["nodes"]["horus"] == {"max_watts": 60}
+    assert entry == {"max_watts": 60, "provision_pending": True}
+    assert "horus" not in base["nodes"]
+
+
+def test_other_nodes_preserved():
+    man = mad.add_entry(_synced_manifest(), OV, "horus", {})
+    assert man["nodes"]["anubis"] == {"max_watts": 90}
+
+
+def test_committed_overlay_fixture():
+    # The repo's own overlay.yaml (pinned by this commit), not the toy OV above:
+    # every node_override and meta key it declares must survive an add.
+    ov = yaml.safe_load(open(os.path.join(HERE, "overlay.yaml")))
+    man = _synced_manifest(ov)
+    man = mad.add_entry(man, ov, "horus", {"max_watts": 60})
+    assert _drift(man, ov) == []
+    victim = next(iter(ov.get("node_overrides") or {}), None)
+    if victim:
+        man = mad.add_entry(man, ov, victim, {"survey_only": True})
+        assert _drift(man, ov) == []
