+def _apply_staged_locked(args, ticket, attempt, worker, node, tree, argv, verb, rule,
+                         private, patch_sha, backup, unit, spec):
+    t0 = time.time()
+    # backup paths are tree-relative and `git apply` resolves patch paths from the repo
+    # top-level, so the two only agree when the tree IS a top-level.
+    top = run_local(["git", "-C", tree, "rev-parse", "--show-toplevel"], timeout=30)
+    if top.returncode != 0 or os.path.realpath(top.stdout.strip()) != os.path.realpath(tree):
+        deny(ticket, attempt, worker, node, verb, argv, "apply:tree_not_toplevel",
+             f"{tree} is not a git top-level ({(top.stdout or top.stderr).strip()[:120]!r})")
+    chk = run_local(["git", "-C", tree, "apply", "--check", "--", private], timeout=60)
+    if chk.returncode != 0:
+        deny(ticket, attempt, worker, node, verb, argv, "apply:check_failed",
+             f"git apply --check refused (nothing changed): {(chk.stderr or chk.stdout).strip()[:300]}")
+    audit(P.audit_record(ticket=ticket, attempt=attempt, worker=worker, node=node, verb=verb,
+                          argv=argv, decision="allow", rule=rule,
+                          out_head=f"patch={patch_sha[:12]} backup={backup} restart={unit}"))
+    ap = run_local(["git", "-C", tree, "apply", "--", private], timeout=60)
+    failure = None
+    if ap.returncode != 0:
+        failure = f"git apply exited {ap.returncode}: {(ap.stderr or ap.stdout).strip()[:200]}"
+    restart_detail = None
+    if failure is None and unit:
+        rc, restart_detail = restart_via_broker(node, unit)
+        if rc != 0:
+            failure = f"restart {unit} exited {rc}: {restart_detail}"
+    pc_detail = None
+    if failure is None:
+        ok, pc_detail, _ = run_postcheck(node, spec)
+        if not ok:
+            failure = f"postcheck mismatch: {pc_detail}"
+    if failure is None:
+        audit(P.audit_record(ticket=ticket, attempt=attempt, worker=worker, node=node,
+                              verb=verb, argv=argv, decision="allow", rule="apply:postcheck_ok",
+                              exit_code=0, elapsed_s=time.time() - t0, verified=True,
+                              out_head=pc_detail[:240]))
+        print(f"fleet-exec: applied {patch_sha[:12]} to {tree}"
+              f"{f', restarted {unit}' if unit else ''}; post-check ok: {pc_detail}")
+        sys.exit(0)
+    # ---- rollback: restore the verified backup, reload the unit, block the ticket ----
+    restored, restore_detail = S.restore_backup(tree, backup)
+    re_rc, re_detail = (restart_via_broker(node, unit) if unit else (0, "no unit"))
+    outcome = "rolled-back" if restored else "ROLLBACK-FAILED"
+    reason = (f"ops-apply:postcheck-failed ({outcome}) wq#{ticket} {tree}: {failure}; "
+              f"{restore_detail}; re-restart rc={re_rc}")
+    block_rc, block_out = wq_block(ticket, reason)
+    audit(P.audit_record(ticket=ticket, attempt=attempt, worker=worker, node=node, verb=verb,
+                          argv=argv, decision="allow",
+                          rule="apply:rolled_back" if restored else "apply:rollback_failed",
+                          exit_code=EXIT_ROLLED_BACK if restored else EXIT_ROLLBACK_FAILED,
+                          elapsed_s=time.time() - t0, verified=False,
+                          out_head=f"{failure[:120]} | {restore_detail[:60]} | block rc={block_rc}"))
+    notify("high" if restored else "urgent", f"ops-apply {outcome}: wq{ticket}", reason[:900])
+    print(f"fleet-exec: {reason} (wq block rc={block_rc}: {block_out})", file=sys.stderr)
+    sys.exit(EXIT_ROLLED_BACK if restored else EXIT_ROLLBACK_FAILED)
+
+
