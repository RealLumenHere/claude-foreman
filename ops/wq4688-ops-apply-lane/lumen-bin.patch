+# ---------------------------------------------------------------------------
+# ops_apply_staged: patch shapes, backup make/verify/restore
+# ---------------------------------------------------------------------------
+
+def git(tree, *args, check=True):
+    return subprocess.run(["git", "-C", str(tree), *args], capture_output=True, text=True,
+                          check=check)
+
+
+def make_tree(path):
+    path.mkdir()
+    git(path, "init", "-q")
+    git(path, "config", "user.email", "t@lumen")
+    git(path, "config", "user.name", "t")
+    (path / "app.txt").write_text("version=1\n")
+    (path / "keep.txt").write_text("untouched\n")
+    git(path, "add", ".")
+    git(path, "commit", "-q", "-m", "init")
+    return path
+
+
+def staged_patch(tree, edits, out):
+    """Make `edits` ({rel: new_text|None}) in tree, capture `git diff` (with new files
+    via intent-to-add), then reset the tree — the patch is staged, the tree is untouched."""
+    for rel, text in edits.items():
+        p = tree / rel
+        if text is None:
+            p.unlink()
+            continue
+        created = not p.exists()
+        p.parent.mkdir(parents=True, exist_ok=True)
+        p.write_text(text)
+        if created:
+            git(tree, "add", "-N", "--", rel)
+    diff = git(tree, "diff").stdout
+    git(tree, "reset", "-q")
+    git(tree, "checkout", "-q", "--", ".")
+    git(tree, "clean", "-qfd")
+    out.write_text(diff)
+    return out
+
+
+def test_patch_touched_files_modify_create_delete(tmp_path):
+    tree = make_tree(tmp_path / "t")
+    p = staged_patch(tree, {"app.txt": "version=2\n", "new/n.txt": "n\n", "keep.txt": None},
+                     tmp_path / "p.patch")
+    assert S.patch_touched_files(p.read_bytes()) == ["app.txt", "keep.txt", "new/n.txt"]
+
+
+@pytest.mark.parametrize("patch,code", [
+    (b"", "STAGED_PATCH_INVALID"),
+    (b"diff --git a/x b/y\nrename from x\nrename to y\n", "STAGED_PATCH_UNSUPPORTED"),
+    (b"diff --git a/x b/x\nold mode 100644\nnew mode 100755\n", "STAGED_PATCH_UNSUPPORTED"),
+    (b"diff --git a/x b/x\nGIT binary patch\n", "STAGED_PATCH_UNSUPPORTED"),
+    (b"diff --git a/x b/x\nnew file mode 120000\n", "STAGED_PATCH_UNSUPPORTED"),
+    (b'diff --git "a/x y" "b/x y"\n', "STAGED_PATCH_UNSUPPORTED"),
+    (b"diff --git a/../x b/../x\n", "STAGED_PATH_UNSAFE"),
+    (b"diff --git a/.git/config b/.git/config\n", "STAGED_PATH_UNSAFE"),
+    (b"diff --git a/x b/x\ndiff --git a/x b/x\n", "STAGED_PATCH_UNSUPPORTED"),
+])
+def test_patch_shapes_refused(patch, code):
+    with pytest.raises(S.StagedError) as e:
+        S.patch_touched_files(patch)
+    assert e.value.code == code
