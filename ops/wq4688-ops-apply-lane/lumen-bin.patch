+def test_verify_backup_refusals(tmp_path, mutate, code):
+    tree = make_tree(tmp_path / "t")
+    patch = staged_patch(tree, {"app.txt": "version=2\n", "new.txt": "n\n"},
+                         tmp_path / "p.patch").read_bytes()
+    backup = tmp_path / "bk"
+    S.make_backup(str(tree), patch, str(backup))
+    check_patch = patch
+    check_tree = str(tree)
