+def test_staged_broken_patch_auto_rolls_back_and_blocks(cli, monkeypatch):
+    """Design §7 exit criterion for option B: the staged patch applies cleanly but
+    breaks the post-check -> restore from the verified backup, re-restart, wq block."""
+    patch, backup = stage(cli, {"app.txt": "version=BROKEN\n", "added.txt": "x\n"})
+    set_grant(monkeypatch, cli["tmp"], apply_grant(cli, patch, backup, expect="version=2"))
+    assert run_cli(["apply-staged", "lumen", str(cli["tree"])]) == fleet_exec.EXIT_ROLLED_BACK
+    assert (cli["tree"] / "app.txt").read_text() == "version=1\n"
+    assert not (cli["tree"] / "added.txt").exists()
+    assert git(cli["tree"], "status", "--porcelain").stdout == ""
+    assert cli["calls"]["restart"] == [("lumen", "lumen-messenger")] * 2
+    (ticket, reason), = cli["calls"]["wq"]
+    assert ticket == str(TICKET) and reason.startswith("ops-apply:postcheck-failed (rolled-back)")
+    assert read_jsonl(cli["audit"])[-1]["rule"] == "apply:rolled_back"
+    assert cli["calls"]["ntfy"][0][0] == "high"
+
