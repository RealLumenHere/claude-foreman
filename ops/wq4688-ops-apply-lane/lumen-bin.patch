+    check_node_known(ticket, attempt, worker, node, verb, argv)
+    entries = [g for g in P.find_grants(grant, "apply", node) if g.get("tree") == tree]
+    if len(entries) != 1:
+        deny(ticket, attempt, worker, node, verb, argv, "grant:no_apply_tree",
