+def apply_grant(cli, patch_path, backup, *, unit="lumen-messenger", expect="version=2",
+                node="lumen", tree=None):
+    tree = str(tree or cli["tree"])
+    g = [{"kind": "apply", "node": node, "tree": tree, "patch": str(patch_path),
+          "patch_sha256": S.sha256_bytes(patch_path.read_bytes()), "backup": str(backup),
+          "restart": unit,
+          "postcheck": {"argv": ["cat", os.path.join(tree, "app.txt")], "expect": expect}}]
+    if unit:
+        g.append({"kind": "restart", "node": node, "unit": unit})
+    return g
+
+
+def run_cli(argv):
+    with pytest.raises(SystemExit) as e:
+        fleet_exec.main(argv)
+    return e.value.code
+
+
+def stage(cli, edits, name="p"):
+    patch = staged_patch(cli["tree"], edits, cli["tmp"] / f"{name}.patch")
+    backup = cli["tmp"] / "backups" / name
+    S.make_backup(str(cli["tree"]), patch.read_bytes(), str(backup))
+    return patch, backup
+
+
+def test_apply_staged_success_applies_restarts_and_verifies(cli, monkeypatch):
+    patch, backup = stage(cli, {"app.txt": "version=2\n"})
+    set_grant(monkeypatch, cli["tmp"], apply_grant(cli, patch, backup))
+    assert run_cli(["apply-staged", "lumen", str(cli["tree"])]) == 0
+    assert (cli["tree"] / "app.txt").read_text() == "version=2\n"
+    assert cli["calls"]["restart"] == [("lumen", "lumen-messenger")]
+    assert cli["calls"]["wq"] == []
+    assert read_jsonl(cli["audit"])[-1]["rule"] == "apply:postcheck_ok"
+
