+# --- ops-apply lane verbs (wq#4688, foreman design/orchestrator_verify_lane.md §3 ---
+# option B + §6). Two mutation verbs, both reachable ONLY through a grant the ops-apply
+# lane spawner mints after its five gates pass (report, judge PASS, precheck, backup,
+# target). Same fail-closed shape as every check_* above: (ok, rule, reason), deny is the
+# default, never.nodes / THOR_HARDLOCK first. Neither verb reads or widens any never.* row.
+
+# apply-staged edits files in a tree with uid lumen and restores them from a backup on a
+# failed post-check. v1 is Lumen-local only: the spawner verifies the backup on Lumen's
+# filesystem before the worker exists, which it cannot do for a remote node.
+APPLY_STAGED_LOCAL_NODES = frozenset({"lumen"})
+
+_CONTAINER_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$")
+
+
+def _never_node(node, policy):
+    return node in THOR_HARDLOCK or node in policy.get("never", {}).get("nodes", [])
+
+
+def check_apply_staged(node, tree, policy):
+    """apply-staged <node> <tree>: tree must be an exact entry of
+    allow.apply_staged[node] (no globs, no prefixes: a sub-path of an allowed tree is a
+    different tree). Absent allow.apply_staged = nothing is allowed."""
+    if _never_node(node, policy):
+        return False, "policy:never_nodes", f"{node} allows no verb except readonly run/copy"
+    if node not in APPLY_STAGED_LOCAL_NODES:
+        return False, "policy:apply_node_not_local", \
+            f"apply-staged v1 runs on {sorted(APPLY_STAGED_LOCAL_NODES)} only, not {node!r}"
+    if (not isinstance(tree, str) or not tree.startswith("/")
+            or os.path.normpath(tree) != tree or _METACHAR_RE.search(tree)):
+        return False, "policy:apply_tree_invalid", f"{tree!r} is not a normalized absolute path"
+    trees = (policy.get("allow", {}).get("apply_staged") or {}).get(node) or []
+    if tree not in trees:
+        return False, "policy:apply_tree_not_allowed", \
+            f"{tree} not in allow.apply_staged[{node}]={trees!r}"
+    return True, "policy:apply_staged", tree
+
+
+def check_docker_exec(node, container, argv, policy):
+    """docker-exec-allowlisted <node> <container> -- <argv>: (container, argv-prefix)
+    pairs from allow.docker_exec[node][container]. A prefix is whole tokens ("ntfy
+    access" admits ["ntfy", "access", ...], never ["ntfy", "accessx"]). argv passes the
+    shared shape check (no metacharacters, bare argv[0]), never carries -c, and is never
+    an interpreter. Absent allow.docker_exec = nothing is allowed."""
+    if _never_node(node, policy):
+        return False, "policy:never_nodes", f"{node} allows no verb except readonly run/copy"
+    if not isinstance(container, str) or not _CONTAINER_RE.match(container):
+        return False, "policy:docker_container_invalid", f"{container!r} is not a container name"
+    shape_err = check_argv_shape(argv)
+    if shape_err:
+        return False, f"argv:{shape_err}", "argv shape rejected before allowlist"
+    if "-c" in argv[1:]:
+        return False, "policy:dash_c_denied", "-c is never allowed for docker-exec"
+    base = _basename(argv[0])
+    if base in _SHELL_ESCAPE_BASENAMES:
+        return False, "policy:shell_escape_basename", f"{base} is never a docker-exec target"
+    by_node = (policy.get("allow", {}).get("docker_exec") or {}).get(node) or {}
+    prefixes = (by_node.get(container) or []) if isinstance(by_node, dict) else []
+    for prefix in prefixes:
+        toks = str(prefix).split()
+        if toks and argv[:len(toks)] == toks:
+            return True, "policy:docker_exec", prefix
+    return False, "policy:docker_exec_not_allowed", \
+        f"{container}: {' '.join(argv)!r} matches no allow.docker_exec[{node}][{container}] prefix"
+
+
