+def test_check_failure_changes_nothing(cli, monkeypatch):
+    patch, backup = stage(cli, {"app.txt": "version=2\n"})
+    # the backup is of the current state, but a context line no longer matches
+    (cli["tree"] / "app.txt").write_text("version=1\n")
+    bad = patch.read_text().replace(" version=1", " version=0").replace("-version=1", "-version=0")
+    patch.write_text(bad)
+    shutil_rm(backup)
+    S.make_backup(str(cli["tree"]), patch.read_bytes(), str(backup))
+    set_grant(monkeypatch, cli["tmp"], apply_grant(cli, patch, backup))
+    assert run_cli(["apply-staged", "lumen", str(cli["tree"])]) == 2
+    assert read_jsonl(cli["audit"])[-1]["rule"] == "apply:check_failed"
+    assert (cli["tree"] / "app.txt").read_text() == "version=1\n"
+    assert cli["calls"]["restart"] == [] and cli["calls"]["wq"] == []
+
+
+def shutil_rm(path):
+    import shutil
+    shutil.rmtree(path)
+
