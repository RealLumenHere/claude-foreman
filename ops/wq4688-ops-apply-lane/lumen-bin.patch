+def test_backup_roundtrip_restores_modify_create_delete(tmp_path):
+    tree = make_tree(tmp_path / "t")
+    patch = staged_patch(tree, {"app.txt": "version=2\n", "new/n.txt": "n\n", "keep.txt": None},
+                         tmp_path / "p.patch").read_bytes()
+    backup = tmp_path / "bk" / "wq1"
+    S.make_backup(str(tree), patch, str(backup))
+    S.verify_backup(str(tree), patch, str(backup), expected_patch_sha=S.sha256_bytes(patch))
+    tmp = tmp_path / "apply.patch"
