+"""ops_apply_staged — the backup/patch/post-check half of the ops-apply lane (wq#4688,
+foreman design/orchestrator_verify_lane.md §3 option B + §6).
+
+Shared by two callers that must agree byte-for-byte:
+  * fleet-exec `apply-staged` (the broker verb that edits a tree and rolls it back), and
+  * foreman harness/ops_apply_lane.py (the spawner's BACKUP gate, run before the worker
+    exists, and the orchestrator's `backup` helper that makes the backup in the first
+    place).
+
+A backup is a directory the broker can restore from without guessing:
+
+    <backup>/ops-apply-backup.json   {"version": 1, "tree": ..., "patch_sha256": ...,
+                                      "files": {"<rel>": "<sha256>" | null}}
+    <backup>/files/<rel>             a copy of every file the patch modifies or deletes
+
+`null` marks a file the patch creates (restore deletes it). verify_backup() checks the
+backup against the LIVE tree, not against a timestamp: every recorded sha must equal
+the live file right now, so a backup taken before someone else changed the file is
+refused rather than restored over their change (strictly stronger than the design's
+"backup newer than the target's mtime").
+
+v1 patch shapes are deliberately narrow: plain text modify/create/delete of regular
+files inside the tree. Renames, copies, mode changes, symlinks, binary hunks, quoted
+(non-ASCII/space) paths and any path that leaves the tree are refused — each is a
+restore case this module would otherwise have to get right under pressure.
+
+No subprocess, no ssh: file I/O and urllib only, so both callers can unit-test it.
+"""
+import hashlib
+import json
+import os
+import re
+import shutil
+import tempfile
+import time
+import urllib.request
+
+BACKUP_MANIFEST = "ops-apply-backup.json"
+BACKUP_FILES_DIR = "files"
+BACKUP_VERSION = 1
+
+_SHA256_RE = re.compile(r"^[0-9a-f]{64}$")
+_DIFF_GIT_RE = re.compile(r"^diff --git a/(\S+) b/(\S+)$")
+_REFUSED_HEADERS = (
+    ("rename from", "rename"), ("rename to", "rename"),
+    ("copy from", "copy"), ("copy to", "copy"),
+    ("old mode", "mode change"), ("new mode", "mode change"),
+    ("GIT binary patch", "binary"), ("Binary files", "binary"),
+)
+_OK_FILE_MODES = ("100644", "100755")
+
+
+class StagedError(Exception):
+    """One refusal; `code` is the machine-readable tag both callers log."""
+
+    def __init__(self, code, message):
+        super().__init__(f"{code}: {message}")
+        self.code = code
+        self.message = message
+
+
+def sha256_bytes(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def sha256_file(path):
+    """sha256 of a regular file, None if absent. A symlink or non-regular file is a
+    refusal, never followed: the backup must describe exactly what restore rewrites."""
+    if not os.path.lexists(path):
+        return None
+    if os.path.islink(path) or not os.path.isfile(path):
+        raise StagedError("STAGED_NOT_REGULAR", f"{path} is not a regular file")
+    with open(path, "rb") as f:
+        return sha256_bytes(f.read())
+
+
+def is_sha256(value):
+    return isinstance(value, str) and bool(_SHA256_RE.match(value))
+
+
+def _safe_rel(rel):
+    if (not rel or rel.startswith("/") or "\\" in rel
+            or any(part in ("", ".", "..") for part in rel.split("/"))):
+        raise StagedError("STAGED_PATH_UNSAFE", f"{rel!r} is not a plain relative path")
+    if rel == ".git" or rel.startswith(".git/"):
+        raise StagedError("STAGED_PATH_UNSAFE", f"{rel!r} is inside .git")
+    return rel
+
+
+def _inside(tree, rel):
+    """Absolute path of rel under tree, refusing anything whose real parent directory
+    leaves the tree (a symlinked directory inside the tree counts as leaving)."""
+    root = os.path.realpath(tree)
+    path = os.path.join(root, rel)
+    parent = os.path.realpath(os.path.dirname(path))
+    if parent != root and not parent.startswith(root + os.sep):
+        raise StagedError("STAGED_PATH_UNSAFE", f"{rel!r} resolves outside {tree}")
+    return path
+
+
+def patch_touched_files(patch_bytes):
+    """Sorted relative paths a git-format patch touches, or StagedError. Every
+    `diff --git` section must name the same path on both sides and carry none of the
+    refused v1 shapes; a patch with no section at all is refused (nothing to apply is
+    not a successful apply)."""
+    try:
+        text = patch_bytes.decode("utf-8")
+    except UnicodeDecodeError:
+        raise StagedError("STAGED_PATCH_INVALID", "patch is not UTF-8 text") from None
+    files = []
+    for line in text.splitlines():
+        if line.startswith("diff --git "):
+            m = _DIFF_GIT_RE.match(line)
+            if not m or '"' in line:
+                raise StagedError("STAGED_PATCH_UNSUPPORTED", f"unparseable header {line[:120]!r}")
+            a, b = m.group(1), m.group(2)
+            if a != b:
+                raise StagedError("STAGED_PATCH_UNSUPPORTED", f"{a} -> {b}: renames are refused in v1")
+            files.append(_safe_rel(a))
+            continue
+        for prefix, what in _REFUSED_HEADERS:
+            if line.startswith(prefix):
+                raise StagedError("STAGED_PATCH_UNSUPPORTED", f"{what} sections are refused in v1")
+        for prefix in ("new file mode ", "deleted file mode "):
+            if line.startswith(prefix) and line[len(prefix):].strip() not in _OK_FILE_MODES:
+                raise StagedError("STAGED_PATCH_UNSUPPORTED",
+                                  f"{line.strip()!r}: only regular-file modes are allowed")
+    if not files:
+        raise StagedError("STAGED_PATCH_INVALID", "patch has no `diff --git` section")
+    if len(set(files)) != len(files):
+        raise StagedError("STAGED_PATCH_UNSUPPORTED", "patch touches the same file twice")
+    return sorted(files)
+
+
+def _read_manifest(backup_dir):
+    path = os.path.join(backup_dir, BACKUP_MANIFEST)
+    try:
+        with open(path) as f:
+            data = json.load(f)
+    except (OSError, ValueError) as e:
+        raise StagedError("BACKUP_MANIFEST_INVALID", f"{path}: {e}") from None
+    if (not isinstance(data, dict) or data.get("version") != BACKUP_VERSION
+            or not isinstance(data.get("files"), dict)):
+        raise StagedError("BACKUP_MANIFEST_INVALID", f"{path}: not a v{BACKUP_VERSION} backup manifest")
+    return data
+
+
+def make_backup(tree, patch_bytes, backup_dir):
+    """Copy every file the patch touches out of tree into a NEW backup_dir. Refuses an
+    existing backup_dir so a backup is never half-overwritten. Returns the manifest."""
+    if os.path.lexists(backup_dir):
+        raise StagedError("BACKUP_EXISTS", f"{backup_dir} already exists — pick a new path")
+    files = patch_touched_files(patch_bytes)
+    record = {}
+    os.makedirs(os.path.dirname(os.path.abspath(backup_dir)), exist_ok=True)
+    staging = tempfile.mkdtemp(prefix=".ops-apply-backup-", dir=os.path.dirname(os.path.abspath(backup_dir)))
+    try:
+        for rel in files:
+            live = _inside(tree, rel)
+            sha = sha256_file(live)
+            record[rel] = sha
+            if sha is not None:
+                dst = os.path.join(staging, BACKUP_FILES_DIR, rel)
+                os.makedirs(os.path.dirname(dst), exist_ok=True)
+                shutil.copy2(live, dst)
+                if sha256_file(dst) != sha:
+                    raise StagedError("BACKUP_COPY_MISMATCH", f"{rel} changed while being copied")
+        manifest = {"version": BACKUP_VERSION, "tree": tree,
+                    "patch_sha256": sha256_bytes(patch_bytes), "files": record,
+                    "created": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())}
+        with open(os.path.join(staging, BACKUP_MANIFEST), "w") as f:
+            json.dump(manifest, f, indent=2, sort_keys=True)
+            f.write("\n")
+        os.rename(staging, backup_dir)
+    except BaseException:
+        shutil.rmtree(staging, ignore_errors=True)
+        raise
+    return manifest
+
+
+def verify_backup(tree, patch_bytes, backup_dir, expected_patch_sha=None):
+    """Raise StagedError unless backup_dir is a complete backup of the CURRENT state of
+    every file this patch touches in tree. Returns the manifest on success."""
+    if not os.path.isdir(backup_dir) or os.path.islink(backup_dir):
+        raise StagedError("BACKUP_MISSING", f"{backup_dir} is not a directory")
+    data = _read_manifest(backup_dir)
+    patch_sha = sha256_bytes(patch_bytes)
+    if expected_patch_sha is not None and patch_sha != expected_patch_sha:
+        raise StagedError("BACKUP_PATCH_MISMATCH", "patch bytes do not match the pinned sha256")
+    if data.get("tree") != tree:
+        raise StagedError("BACKUP_TREE_MISMATCH", f"backup is of {data.get('tree')!r}, not {tree!r}")
+    if data.get("patch_sha256") != patch_sha:
+        raise StagedError("BACKUP_PATCH_MISMATCH", "backup was taken for a different patch")
+    files = patch_touched_files(patch_bytes)
+    if sorted(data["files"]) != files:
+        raise StagedError("BACKUP_INCOMPLETE",
+                          f"backup lists {sorted(data['files'])}, patch touches {files}")
+    for rel, sha in data["files"].items():
+        live = _inside(tree, rel)
+        live_sha = sha256_file(live)
+        if sha is None:
+            if live_sha is not None:
+                raise StagedError("BACKUP_STALE", f"{rel} exists now but the backup says the patch creates it")
+            continue
+        if not is_sha256(sha):
+            raise StagedError("BACKUP_MANIFEST_INVALID", f"{rel}: bad sha256 {sha!r}")
+        copy_sha = sha256_file(os.path.join(backup_dir, BACKUP_FILES_DIR, rel))
+        if copy_sha != sha:
+            raise StagedError("BACKUP_INCOMPLETE", f"{rel}: backup copy missing or altered")
+        if live_sha != sha:
+            raise StagedError("BACKUP_STALE", f"{rel}: live file differs from the backup "
+                                              f"(changed since the backup was taken)")
+    return data
+
+
+def restore_backup(tree, backup_dir):
+    """Put every recorded file back (atomic replace per file) and delete the ones the
+    patch created; then re-hash. Returns (ok, detail) — never raises, because the
+    caller is already on its failure path and must still block the ticket."""
+    try:
+        data = _read_manifest(backup_dir)
+        for rel, sha in sorted(data["files"].items()):
+            live = _inside(tree, _safe_rel(rel))
+            if sha is None:
+                if os.path.lexists(live):
+                    os.remove(live)
+                continue
+            src = os.path.join(backup_dir, BACKUP_FILES_DIR, rel)
+            os.makedirs(os.path.dirname(live), exist_ok=True)
+            fd, tmp = tempfile.mkstemp(prefix=".ops-apply-restore-", dir=os.path.dirname(live))
+            os.close(fd)
+            shutil.copy2(src, tmp)
+            os.replace(tmp, live)
+        bad = [rel for rel, sha in data["files"].items()
+               if sha256_file(_inside(tree, rel)) != sha]
+    except (StagedError, OSError) as e:
+        return False, f"restore error: {e}"
+    if bad:
+        return False, f"restored files still differ from backup: {bad}"
+    return True, f"restored {len(data['files'])} file(s) from {backup_dir}"
+
+
+def postcheck_once(spec, *, run_argv=None, opener=None, timeout=15):
+    """One post-check read. spec is the pinned dict {"http": url | "argv": [...],
+    "expect": substring}. Returns (ok, detail). HTTP is GET only (no body, no method
+    override); argv goes through the caller's run_argv (the broker validates it against
+    run_readonly_cmds and runs it the same way `fleet-exec run` does)."""
+    expect = spec.get("expect")
+    if not isinstance(expect, str) or not expect:
+        return False, "postcheck has no expect string"
+    if spec.get("http"):
+        url = spec["http"]
+        if not url.startswith(("http://", "https://")):
+            return False, f"postcheck url {url!r} is not http(s)"
+        req = urllib.request.Request(url, method="GET")
+        try:
+            resp = (opener or urllib.request.urlopen)(req, timeout=timeout)
+            status = getattr(resp, "status", None)
+            body = resp.read(1 << 20).decode("utf-8", "replace")
+        except Exception as e:  # noqa: BLE001 — any read failure is a mismatch, never a pass
+            return False, f"GET {url} failed: {type(e).__name__}: {e}"
+        if status != 200:
+            return False, f"GET {url} -> HTTP {status}"
+        if expect not in body:
+            return False, f"GET {url} -> 200 but {expect!r} not in body"
+        return True, f"GET {url} -> 200, {expect!r} present"
+    if spec.get("argv"):
+        if run_argv is None:
+            return False, "argv postcheck with no runner"
+        rc, out = run_argv(spec["argv"])
+        if rc != 0:
+            return False, f"{' '.join(spec['argv'])!r} exited {rc}"
+        if expect not in out:
+            return False, f"{' '.join(spec['argv'])!r} output lacks {expect!r}"
+        return True, f"{' '.join(spec['argv'])!r} ok, {expect!r} present"
+    return False, "postcheck names neither http nor argv"
+
+
+def postcheck(spec, *, budget_s=30, interval_s=2, sleep=time.sleep, clock=time.monotonic, **kw):
+    """Poll postcheck_once until it passes or budget_s runs out (a restarted unit needs a
+    few seconds to listen). Returns (ok, detail_of_last_try)."""
+    deadline = clock() + budget_s
+    while True:
+        ok, detail = postcheck_once(spec, **kw)
+        if ok or clock() >= deadline:
+            return ok, detail
+        sleep(interval_s)
