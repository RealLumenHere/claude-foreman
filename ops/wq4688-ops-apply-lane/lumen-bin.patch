+@pytest.mark.parametrize("tamper,rule", [
+    ("patch_changed", "apply:patch_sha_mismatch"),
+    ("backup_stale", "apply:backup_stale"),
+    ("no_apply_grant", "grant:no_apply_tree"),
+    ("no_restart_grant", "grant:no_restart_unit"),
+    ("crown_jewel_unit", "policy:never_restart"),
+    ("postcheck_not_readonly", "policy:not_readonly"),
+    ("missing_postcheck", "grant:apply_entry_invalid"),
+])
+def test_apply_staged_denials_change_nothing(cli, monkeypatch, tamper, rule):
+    patch, backup = stage(cli, {"app.txt": "version=2\n"})
+    grants = apply_grant(cli, patch, backup)
+    if tamper == "patch_changed":
+        patch.write_text(patch.read_text() + "\n")
+    elif tamper == "backup_stale":
+        (cli["tree"] / "app.txt").write_text("version=1\n# hand edit\n")
+    elif tamper == "no_apply_grant":
+        grants = [g for g in grants if g["kind"] != "apply"]
+    elif tamper == "no_restart_grant":
+        grants = [g for g in grants if g["kind"] != "restart"]
+    elif tamper == "crown_jewel_unit":
+        grants[0]["restart"] = "cloudflared"
+        grants[1]["unit"] = "cloudflared"
+    elif tamper == "postcheck_not_readonly":
+        grants[0]["postcheck"] = {"argv": ["rm", "-rf", "x"], "expect": "y"}
+    elif tamper == "missing_postcheck":
+        del grants[0]["postcheck"]
+    before = (cli["tree"] / "app.txt").read_text()
+    set_grant(monkeypatch, cli["tmp"], grants)
+    assert run_cli(["apply-staged", "lumen", str(cli["tree"])]) == 2
+    rec = read_jsonl(cli["audit"])[-1]
+    assert rec["decision"] == "deny" and rec["rule"] == rule
+    assert (cli["tree"] / "app.txt").read_text() == before
+    assert cli["calls"]["restart"] == [] and cli["calls"]["wq"] == []
+
