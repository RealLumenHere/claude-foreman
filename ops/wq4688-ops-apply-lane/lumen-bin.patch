+    try:
+        S.verify_backup(tree, patch_bytes, backup, expected_patch_sha=patch_sha)
+    except S.StagedError as e:
+        deny(ticket, attempt, worker, node, verb, argv, f"apply:{e.code.lower()}", e.message)
+    fd, private = tempfile.mkstemp(prefix=f"ops-apply-wq{ticket}-", suffix=".patch")
+    try:
