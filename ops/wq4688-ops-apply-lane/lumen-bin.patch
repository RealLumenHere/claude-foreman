+        deny(ticket, attempt, worker, node, verb, argv, rule_pc, f"postcheck: {reason}")
+    if unit:
+        if not any(r.get("unit") == unit for r in P.find_grants(grant, "restart", node)):
+            deny(ticket, attempt, worker, node, verb, argv, "grant:no_restart_unit",
+                 f"apply pins restart {unit} but the grant has no restart entry for it")
+        ok, rule_r, reason = P.check_restart(node, unit, policy)
+        if not ok:
+            deny(ticket, attempt, worker, node, verb, argv, rule_r, reason)
+    # TOCTOU: hash once, then apply from a private 0600 copy of exactly those bytes.
+    try:
+        with open(patch_path, "rb") as f:
+            patch_bytes = f.read()
+    except OSError as e:
+        deny(ticket, attempt, worker, node, verb, argv, "apply:patch_unreadable", str(e))
+    if S.sha256_bytes(patch_bytes) != patch_sha:
+        deny(ticket, attempt, worker, node, verb, argv, "apply:patch_sha_mismatch",
