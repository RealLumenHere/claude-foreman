+class _Resp:
+    def __init__(self, status, body):
+        self.status, self._body = status, body
+
+    def read(self, n=-1):
+        return self._body
+
+
+def test_postcheck_http_and_argv():
+    ok, _ = S.postcheck_once({"http": "http://x/wq", "expect": "detail"},
+                             opener=lambda req, timeout: _Resp(200, b'{"detail": 1}'))
+    assert ok
+    ok, d = S.postcheck_once({"http": "http://x/wq", "expect": "detail"},
+                             opener=lambda req, timeout: _Resp(500, b"detail"))
+    assert not ok and "500" in d
+    ok, _ = S.postcheck_once({"argv": ["cat", "f"], "expect": "v2"}, run_argv=lambda a: (0, "v2\n"))
+    assert ok
+    ok, _ = S.postcheck_once({"argv": ["cat", "f"], "expect": "v2"}, run_argv=lambda a: (0, "v1\n"))
+    assert not ok
+    assert not S.postcheck_once({"http": "file:///etc/passwd", "expect": "root"})[0]
+    assert not S.postcheck_once({"http": "http://x", "expect": ""})[0]
+
+
+def test_postcheck_polls_until_budget():
+    calls = []
+    clock = iter([0, 0, 1, 2, 3, 100]).__next__
+    ok, _ = S.postcheck({"argv": ["cat", "f"], "expect": "v2"}, budget_s=5, interval_s=0,
+                        sleep=lambda s: None, clock=clock,
+                        run_argv=lambda a: (calls.append(1), (0, "v2" if len(calls) == 3 else "v1"))[1])
+    assert ok and len(calls) == 3
