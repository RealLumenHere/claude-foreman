+def read_jsonl(path):
+    if not os.path.exists(path):
+        return []
+    with open(path) as f:
+        return [json.loads(line) for line in f if line.strip()]
+
+
+def write_policy(tmp_path, tree):
+    import yaml
+    path = tmp_path / "policy.yaml"
+    path.write_text(yaml.safe_dump(policy_dict(str(tree))))
+    return str(path)
+
+
+def set_grant(monkeypatch, tmp_path, grants):
+    grant = {"ticket": TICKET, "attempt": 1,
+             "expires": (datetime.now(timezone.utc) + timedelta(hours=1)).strftime("%Y-%m-%dT%H:%M:%SZ"),
+             "grants": grants}
+    raw = json.dumps(grant, sort_keys=True).encode()
+    path = tmp_path / "grant.json"
+    path.write_bytes(raw)
+    monkeypatch.setenv("FOREMAN_GRANT_FILE", str(path))
+    monkeypatch.setenv("FOREMAN_GRANT_SHA", hashlib.sha256(raw).hexdigest())
+    monkeypatch.setenv("FOREMAN_ATTEMPT", "1")
+
+
+@pytest.fixture
+def cli(tmp_path, monkeypatch):
+    tree = make_tree(tmp_path / "tree")
+    calls = {"restart": [], "wq": [], "ntfy": [], "ssh": []}
+    monkeypatch.setattr(fleet_exec, "POLICY_PATH", write_policy(tmp_path, tree))
+    monkeypatch.setattr(fleet_exec, "AUDIT_PATH", str(tmp_path / "audit.jsonl"))
+    monkeypatch.setattr(fleet_exec, "WORKER_AUDIT_PATH", None)
+    monkeypatch.setattr(fleet_exec, "POSTCHECK_BUDGET_S", 0)
+    monkeypatch.setenv("WQ_AGENT", f"fworker-wq{TICKET}")
+    monkeypatch.setattr(fleet_exec, "known_nodes", lambda: {"lumen", "thor", "isis"})
+    monkeypatch.setattr(fleet_exec, "restart_via_broker",
+                        lambda node, unit: (calls["restart"].append((node, unit)), (0, "ok"))[1])
+    monkeypatch.setattr(fleet_exec, "wq_block",
+                        lambda ticket, reason: (calls["wq"].append((ticket, reason)), (0, "BLOCKED"))[1])
+    monkeypatch.setattr(fleet_exec, "notify", lambda *a: calls["ntfy"].append(a))
+
+    def fake_ssh(node, argv, *, input_text=None, timeout=90):
+        calls["ssh"].append((node, list(argv)))
+        if argv[:2] == ["docker", "exec"]:
+            return subprocess.CompletedProcess(argv, 0, "ok\n", "")
+        return subprocess.run(argv, capture_output=True, text=True)  # cat <file> postcheck
+    monkeypatch.setattr(fleet_exec, "run_ssh", fake_ssh)
+    return {"tree": tree, "tmp": tmp_path, "calls": calls, "audit": tmp_path / "audit.jsonl"}
