+@pytest.mark.parametrize("mutate,code", [
+    ("live_changed", "BACKUP_STALE"),
+    ("copy_altered", "BACKUP_INCOMPLETE"),
+    ("other_patch", "BACKUP_PATCH_MISMATCH"),
+    ("other_tree", "BACKUP_TREE_MISMATCH"),
+    ("no_manifest", "BACKUP_MANIFEST_INVALID"),
