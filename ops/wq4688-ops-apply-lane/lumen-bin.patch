+WQ_BIN = os.environ.get("FLEET_EXEC_WQ_BIN", "/home/lumen/bin/wq")
+SELF_PATH = os.path.realpath(__file__)
+POSTCHECK_BUDGET_S = 30
+EXIT_ROLLED_BACK = 3       # mutation reverted, ticket blocked
+EXIT_ROLLBACK_FAILED = 4   # revert did not verify, ticket blocked, urgent page
+
+
+def _valid_postcheck(spec):
+    if not isinstance(spec, dict) or not isinstance(spec.get("expect"), str) or not spec["expect"]:
+        return False
+    if isinstance(spec.get("http"), str):
+        return spec["http"].startswith(("http://", "https://")) and "argv" not in spec
+    argv = spec.get("argv")
+    return isinstance(argv, list) and bool(argv) and all(isinstance(a, str) for a in argv)
+
+
+def _postcheck_policy_ok(node, spec, policy):
+    """An argv post-check is a read: it must pass the same run_readonly_cmds check
+    `fleet-exec run` applies. HTTP post-checks are GET-only by construction."""
+    if spec.get("argv"):
+        return P.check_run(node, spec["argv"], policy)
+    return True, "postcheck:http_get", spec.get("http")
+
+
+def wq_block(ticket, reason):
+    """Best effort but loud: the broker's own audit line records the block attempt and
+    its result, so a failed `wq block` is visible rather than silently dropped."""
+    argv = [WQ_BIN, "block", str(ticket), reason[:900], "--no-probe",
+            "ops-apply rollback: orchestrator must review the failed post-check"]
+    try:
+        p = run_local(argv, timeout=60)
+        return p.returncode, ((p.stdout or "") + (p.stderr or "")).strip()[:240]
+    except (OSError, subprocess.TimeoutExpired) as e:
+        return 1, f"wq block failed: {e}"
+
+
+def restart_via_broker(node, unit):
+    """Re-enter this broker's own `restart` verb (holddown, verify-before/after, rescue
+    start, audit) instead of duplicating it. Same env, so the same grant decides."""
+    try:
+        p = run_local([sys.executable, SELF_PATH, "restart", node, unit], timeout=180)
+        return p.returncode, ((p.stdout or "") + (p.stderr or "")).strip()[:240]
+    except (OSError, subprocess.TimeoutExpired) as e:
+        return 1, f"restart via broker failed: {e}"
+
+
+def run_postcheck(node, spec):
+    t0 = time.time()
+
+    def run_argv(argv):
+        p = run_ssh(node, argv, timeout=60)
+        return p.returncode, (p.stdout or "") + (p.stderr or "")
+    ok, detail = S.postcheck(spec, budget_s=POSTCHECK_BUDGET_S, run_argv=run_argv)
+    return ok, detail, time.time() - t0
+
