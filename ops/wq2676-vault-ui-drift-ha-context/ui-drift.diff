+# wq#2676: hosts whose origin is managed by an HA failover monitor, not by a
+# static config. An ORIGIN_DOWN on one of these is very often the monitor's
+# OWN documented state (primary down, standby not promotable -- see its log)
+# rather than an unknown dashboard/reality mismatch. Annotate, never suppress:
+# the finding still fires every cycle until the host actually answers again.
+HA_HOSTS = {"vault.lumennode.uk": Path("/home/lumen/ha")}
+
+
+def ha_context(host):
+    ha_dir = HA_HOSTS.get(host)
+    if not ha_dir:
+        return None
+    try:
+        primary = (ha_dir / "primary").read_text().strip()
+    except Exception:
+        return None
+    return f"HA primary={primary} -- see {ha_dir}/monitor.log before filing as new drift"
+

