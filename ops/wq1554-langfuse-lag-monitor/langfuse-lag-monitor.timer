# langfuse-lag-monitor.timer — 15-minute Langfuse canary-staleness probe
# (wq#1552/wq#1554, repointed wq#3124).
#
# Each pass confirms the previous pass's canary trace, so healthy staleness
# cycles between 0 and ~15 minutes. The alert threshold
# (LANGFUSE_LAG_THRESHOLD_S, default 2700s = 45 min = 3 poll intervals)
# tolerates two consecutive missed/failed passes before paging, so a single
# transient blip never alerts but a sustained pipeline outage pages within
# the hour.
[Unit]
Description=Langfuse canary-staleness probe (wq#1552/wq#1554/wq#3124)

[Timer]
OnBootSec=5min
OnUnitActiveSec=15min
AccuracySec=1min
RandomizedDelaySec=2min

[Install]
WantedBy=timers.target
