# langfuse-lag-monitor.service — one pass polling Langfuse's export-lag
# metric, alerting via ntfy if lag exceeds threshold (wq#1552, wired wq#1554).
[Unit]
Description=Langfuse export-lag probe — one pass (wq#1552/wq#1554)
Documentation=file:///home/lumen/foreman/ops/wq1554-langfuse-lag-monitor/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=lumen
Group=lumen
ExecStart=/usr/bin/python3 /home/lumen/foreman/harness/langfuse_lag_monitor.py
ExecStartPost=-/home/lumen/bin/lumen-cron-stamp %n
# run() (harness/langfuse_lag_monitor.py) returns 1 on a deliberate skip (no
# creds at LANGFUSE_ENV, or the endpoint fetch/parse failed) — same
# log-only-degradation contract as langfuse_client.load_creds, never
# load-bearing for the caller. That is not a probe failure, so it must not
# trip a restart loop or OnFailure=.
SuccessExitStatus=0 1
TimeoutStartSec=60
Nice=5
