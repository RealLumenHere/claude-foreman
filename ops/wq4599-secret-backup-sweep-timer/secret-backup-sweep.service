# secret-backup-sweep.service - classify secret-bearing backups, shred the provably dead ones (wq#4599).
[Unit]
Description=Classify and retire secret-bearing backups (wq#4599)
Documentation=file:///home/lumen/foreman/ops/wq4599-secret-backup-sweep-timer/README.md
OnFailure=ntfy-onfailure@%n.service

[Service]
Type=oneshot
User=lumen
ExecStart=/home/lumen/bin/secret-backup-sweep timer
# exit 1 = an ORPHAN_LIVE credential was found. The tool has already opened an aq row for it, so that is a finding,
# not a unit failure (a failed unit would also skip the cron stamp below and read as a dead timer).
SuccessExitStatus=1
ExecStartPost=-/home/lumen/bin/lumen-cron-stamp %n
TimeoutStartSec=600
Nice=10
