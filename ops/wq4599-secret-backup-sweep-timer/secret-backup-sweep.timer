# secret-backup-sweep.timer - daily (wq#4599). Backups expire after 7 days, so a daily pass is the right grain.
[Unit]
Description=Classify and retire secret-bearing backups, daily (wq#4599)

[Timer]
OnCalendar=*-*-* 04:40:00
RandomizedDelaySec=10min
Persistent=true

[Install]
WantedBy=timers.target
