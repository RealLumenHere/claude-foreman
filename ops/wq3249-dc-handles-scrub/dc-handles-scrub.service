# dc-handles-scrub.service - redact credentials in the Desktop Commander handle store (wq#3249).
[Unit]
Description=Redact credentials in the DC handle store (wq#3249)
Documentation=file:///home/lumen/foreman/ops/wq3249-dc-handles-scrub/README.md
OnFailure=ntfy-onfailure@%n.service

[Service]
Type=oneshot
User=lumen
ExecStart=/home/lumen/bin/dc-handles-scrub
# exit 0 = clean. Exit 2 (sqlite error) and 3 (raw bytes still dirty after scrub+vacuum) are real failures:
# they fail the unit, which also skips the stamp below so lumen-cron-deadman reports the scrubber stale.
ExecStartPost=-/home/lumen/bin/lumen-cron-stamp %n
TimeoutStartSec=300
Nice=10
