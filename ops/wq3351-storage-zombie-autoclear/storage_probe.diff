+def fresh_plugs():
+    """Plug rows from plugs.json, or [] when the snapshot is older than 15 min."""
+    pj = json.load(open(PLUGS))
+    age = time.time() - datetime.datetime.fromisoformat(pj["updated"]).timestamp()
