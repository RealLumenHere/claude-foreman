+# ---------------------------------------------------------------- check D
+
+def read_text(path):
+    try:
+        with open(path) as f:
+            return f.read()
+    except OSError:
+        return None
+
+
+def ghost_verdict_systemd(facts):
+    """(status, detail) — pure, selftested. A guard's target only needs to be
+    LOADED, not active: plenty of legitimate guard targets are oneshot units or
+    timers that sit inactive between fires. not-found/masked is the ghost."""
+    load = facts.get("LoadState", "unknown")
+    active = facts.get("ActiveState", "unknown")
+    if load in ("not-found", "masked"):
+        return "alert", f"ghost: LoadState={load} (ActiveState={active}) — no guard should be watching this"
+    return "ok", f"LoadState={load}, ActiveState={active}"
+
+
+def docker_ghost_verdict(hits, pattern):
+    """hits: [(name, state), ...] from `docker ps -a`. Pure, selftested."""
+    matched = [(n, s) for n, s in hits if re.search(pattern, n)]
+    running = [n for n, s in matched if s == "running"]
+    if running:
+        return "ok", f"running: {', '.join(running)}"
+    if matched:
+        return "warn", f"present but not running: {', '.join(n for n, _ in matched)}"
+    return "alert", "ghost: no container by this name/pattern"
+
+
+def probe_ghost(kind, name, node, conf):
+    """(severity, detail) for one (kind, name) ref on node, via the same
+    read-only run_on() plumbing check A uses (SSH, never_touch, reachability)."""
+    if kind == "docker":
+        rc, out, reachable = run_on(node, "docker ps -a --format '{{.Names}}\t{{.State}}'", conf)
+        if not reachable or rc != 0:
+            return "skip", "docker not queryable on this node"
+        hits = [tuple(l.split("\t")) for l in out.strip().splitlines() if "\t" in l]
+        return docker_ghost_verdict(hits, name)
+    cmd = f"systemctl show {name} -p LoadState -p ActiveState"
+    rc, out, reachable = run_on(node, cmd, conf)
+    if not reachable:
+        return "skip", f"node unreachable ({out.strip()[:80]})"
+    return ghost_verdict_systemd(unit_facts(out))
+
+
+def extract_healer_units(text):
+    """(kind, name) refs from healer_watch_table.yaml's units:/stall: blocks.
+    Pure over already-read text — selftested against a synthetic table."""
+    import yaml
+    t = yaml.safe_load(text) or {}
+    refs = [(spec.get("kind", "systemd"), name)
+            for name, spec in (t.get("units") or {}).items()]
+    refs += [("systemd", name) for name in (t.get("stall") or {}).keys()]
+    return refs
+
+
+def extract_bracket_list(text, marker):
+    """Quoted strings out of `marker = [...]` or `for s in [...]`. Regex only —
+    never executes the source file. Pure, selftested."""
+    m = re.search(re.escape(marker) + r"\s*(?:=|in)\s*\[([^\]]*)\]", text)
+    if not m:
+        return []
+    return re.findall(r"""['"]([^'"]+)['"]""", m.group(1))
+
+
+SHELL_REF_PATTERNS = (
+    ("systemd", re.compile(r"systemctl (?:restart|start|stop|is-active|is-enabled|status|show) "
+                          r"([A-Za-z0-9_.@-]+)")),
+    ("docker",  re.compile(r"docker inspect -f '[^']*' ([A-Za-z0-9_.-]+)")),
+    ("docker",  re.compile(r"docker (?:restart|stop|start) ([A-Za-z0-9_.-]+)")),
+    ("docker",  re.compile(r"docker ps[^\n]*grep -c ([A-Za-z0-9_.-]+)")),
+    ("docker",  re.compile(r"\bdocker (\S+) recreation\b")),
+)
+
+
+def extract_shell_refs(text):
+    """(kind, name) refs out of a shell snippet or runbook prose string. Pure,
+    selftested. Deliberately narrow: only clearly-named systemctl/docker
+    targets, never a guess at what a bare word might mean."""
+    refs = []
+    for kind, pat in SHELL_REF_PATTERNS:
+        refs += [(kind, m.group(1)) for m in pat.finditer(text)]
+    return refs
+
+
+def extract_aq_runbooks(text):
+    """(kind, name) refs out of aq_escalate.py's RUNBOOKS dict values."""
+    m = re.search(r"RUNBOOKS\s*=\s*\{(.*?)\n\}", text, re.S)
+    if not m:
+        return []
+    try:
+        d = ast.literal_eval("{" + m.group(1) + "}")
+    except Exception:
+        return []
+    refs = []
+    for runbook in d.values():
+        refs += extract_shell_refs(runbook)
+    return refs
+
+
+def extract_drift_golden(text, conf):
+    """(kind, name, node) refs out of drift-assert's GOLDEN list. Only rows
+    whose host is "lumen" or already declared in retired_services.yaml's
+    nodes: map are probed — same roster check_a already trusts."""
+    m = re.search(r"GOLDEN\s*=\s*\[(.*?)\n\]", text, re.S)
+    if not m:
+        return []
+    try:
+        rows = ast.literal_eval("[" + m.group(1) + "]")
+    except Exception:
+        return []
+    refs = []
+    for row in rows:
+        if len(row) < 5:
+            continue
+        _gid, host, _desc, cmd, _expected = row[:5]
+        if host != "lumen" and host not in conf.get("nodes", {}):
+            continue
+        refs += [(kind, name, host) for kind, name in extract_shell_refs(cmd)]
+    return refs
+
+
+def extract_failed_units_allowlist(text):
+    """lumen-failed-units (wq#1657, staged) reads a FINDING_LIST file of unit
+    names to classify "guard fired" vs "guard broke". Returns:
+      None                      — FINDING_LIST not wired yet, nothing to check
+      ("__missing__", path)     — wired, but the list file itself is gone
+      [(kind, name), ...]       — wired and readable
+    """
+    m = re.search(r"FINDING_LIST=(\S+)", text)
+    if not m:
+        return None
+    path = m.group(1).strip("'\"")
+    body = read_text(path)
+    if body is None:
+        return ("__missing__", path)
+    names = [l.strip() for l in body.splitlines() if l.strip() and not l.strip().startswith("#")]
+    return [("systemd", n) for n in names]
+
+
+def check_d(conf, local_only, findings):
+    def missing(label, path):
+        findings.append({"check": "D", "entry": label, "node": "lumen", "target": path,
+                         "severity": "skip", "detail": "source file unreadable"})
+
+    def probe_and_add(label, node, kind, name):
+        if node != "lumen" and local_only:
+            # Same gate check A applies before probing a remote node, reported as
+            # a skip rather than dropped so the roster stays visible in render().
+            findings.append({"check": "D", "entry": f"{label}: {name}", "node": node,
+                             "target": name, "severity": "skip",
+                             "detail": f"named by {label} — not probed (--local-only)"})
+            return
+        sev, detail = probe_ghost(kind, name, node, conf)
+        findings.append({"check": "D", "entry": f"{label}: {name}", "node": node,
+                         "target": name, "severity": sev, "detail": f"named by {label} — {detail}"})
+
+    text = read_text(HEALER_TABLE)
+    if text is None:
+        missing("healer_watch_table.yaml", HEALER_TABLE)
+    else:
+        try:
+            refs = extract_healer_units(text)
+        except Exception as e:
+            refs = []
+            findings.append({"check": "D", "entry": "healer_watch_table.yaml", "node": "lumen",
+                             "target": HEALER_TABLE, "severity": "warn",
+                             "detail": f"could not parse: {e}"})
+        for kind, name in refs:
+            probe_and_add("healer_watch_table.yaml", "lumen", kind, name)
+
+    text = read_text(SPLIT_WATCH_SRC)
+    if text is None:
+        missing("split_watch.py UNITS", SPLIT_WATCH_SRC)
+    else:
+        for name in extract_bracket_list(text, "UNITS"):
+            probe_and_add("split_watch.py UNITS", "lumen", "systemd", name)
+
+    text = read_text(STATUS_MON_SRC)
+    if text is None:
+        missing("lumen_status_monitor.py svc list", STATUS_MON_SRC)
+    else:
+        for name in extract_bracket_list(text, "for s"):
+            probe_and_add("lumen_status_monitor.py svc list", "lumen", "systemd", name)
+
+    text = read_text(AQ_ESCALATE_SRC)
+    if text is None:
+        missing("aq_escalate RUNBOOKS", AQ_ESCALATE_SRC)
+    else:
+        for kind, name in extract_aq_runbooks(text):
+            probe_and_add("aq_escalate RUNBOOKS", "lumen", kind, name)
+
+    text = read_text(DRIFT_ASSERT_SRC)
+    if text is None:
+        missing("drift-assert GOLDEN", DRIFT_ASSERT_SRC)
+    else:
+        for kind, name, node in extract_drift_golden(text, conf):
+            probe_and_add("drift-assert GOLDEN", node, kind, name)
+
+    text = read_text(FAILED_UNITS_SRC)
+    if text is None:
+        missing("lumen-failed-units", FAILED_UNITS_SRC)
+    else:
+        allow = extract_failed_units_allowlist(text)
+        if allow is None:
+            pass  # guard-finding-exit.list not wired yet (wq#1657 still staged) — nothing to check
+        elif isinstance(allow, tuple) and allow[0] == "__missing__":
+            findings.append({"check": "D", "entry": "lumen-failed-units: guard-finding-exit.list",
+                             "node": "lumen", "target": allow[1], "severity": "warn",
+                             "detail": f"FINDING_LIST={allow[1]} is wired in but the file does not exist"})
+        else:
+            for kind, name in allow:
+                probe_and_add("lumen-failed-units guard-finding-exit.list", "lumen", kind, name)
+
+
