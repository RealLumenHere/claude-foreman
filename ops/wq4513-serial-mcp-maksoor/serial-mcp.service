[Unit]
Description=serial-mcp v0.9.3 (qarnet/serial-mcp) - UART MCP server, HTTP on Tailscale IP only
Documentation=https://github.com/qarnet/serial-mcp
After=network-online.target tailscaled.service
Wants=network-online.target tailscaled.service

[Service]
Type=simple
User=maksoor
Group=dialout
ExecStart=/opt/serial-mcp/bin/serial-mcp \
    --transport=http \
    --bind=100.81.204.74:8400 \
    --allowlist=/dev/ttyUSB*,/dev/ttyACM* \
    --capture-dir=/var/log/serial-mcp \
    --profiles-path=/var/lib/serial-mcp/profiles.toml
Restart=on-failure
RestartSec=5
Environment=RUST_LOG=info
StateDirectory=serial-mcp

# Hardening: UART bridge, not a general-purpose service.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/serial-mcp
PrivateTmp=true

[Install]
WantedBy=multi-user.target
