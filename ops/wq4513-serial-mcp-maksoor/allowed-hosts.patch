+
+/// wq#4513 local patch (not upstream): rmcp's streamable-HTTP service rejects
+/// any Host header outside its localhost default (DNS-rebinding guard), so a
+/// server bound to a Tailscale IP refuses every real client with 403. Allow the
+/// host and host:port that --bind names, plus the localhost defaults.
+fn allowed_hosts_for_bind(bind: &str) -> Vec<String> {
+    let mut hosts: Vec<String> = ["localhost", "127.0.0.1", "::1"]
+        .iter()
+        .map(|h| h.to_string())
+        .collect();
+    hosts.push(bind.to_string());
+    if let Some((h, _)) = bind.rsplit_once(':') {
+        let h = h.trim_matches(|c| c == '[' || c == ']');
+        if !h.is_empty() && h != "0.0.0.0" && h != "::" {
+            hosts.push(h.to_string());
+        }
+    }
+    hosts
+}
