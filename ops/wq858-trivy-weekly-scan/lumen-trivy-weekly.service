[Unit]
Description=wq#858 Trivy weekly CVE scan — containers + host rootfs
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=lumen
ExecStart=/home/lumen/services/trivy-weekly/scan.sh
StandardOutput=journal
StandardError=journal
# wq#5239: budget = 2 x trivy rootfs --timeout 45m (scan.sh) + per-image scans (trivy
# image default 5m each) + DB update. 1800 was shorter than one rootfs walk's own cap,
# so systemd would kill a slow walk before Trivy's timeout. Measured runs take ~5 min.
TimeoutStartSec=4h
