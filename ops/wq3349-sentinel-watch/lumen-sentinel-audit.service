[Unit]
Description=sentinel-watch: guards, probes, aq, services, disk, LiteLLM sweep; files tickets (wq#3349)
After=network-online.target

[Service]
Type=oneshot
User=lumen
ExecStart=/home/lumen/bin/sentinel-watch
TimeoutStartSec=900
# wq#3483: exit 4 = findings filed (a successful run); exit 1 stays a crash
SuccessExitStatus=4
Nice=10
