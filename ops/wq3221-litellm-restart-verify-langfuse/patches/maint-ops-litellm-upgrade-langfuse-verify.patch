+# wq#3221: a 200 completion is not proof Langfuse received it (wq#3211 - 47h of LiteLLM->
+# Langfuse traces silently dropped while /v1/models, a real completion and spend-log writes
+# all kept passing). Poll Langfuse's own API for a trace stamped at/after this completion
+# before verify() can PASS. Basic-auth creds come from the SAME env file the litellm
+# container loads (LANGFUSE_ENV_FILE), never typed literally (instinct 4).
+def langfuse_trace_seen(since_ts, env_path, host, timeout_s, name="litellm-acompletion", poll_s=3):
+    try:
+        text = open(env_path).read()
+    except OSError:
+        return None  # creds unreadable from here: cannot check, caller decides how to treat that
+    pk = re.search(r"^LANGFUSE_PUBLIC_KEY=(\S+)$", text, re.M)
+    sk = re.search(r"^LANGFUSE_SECRET_KEY=(\S+)$", text, re.M)
+    if not pk or not sk:
+        return None
+    auth = base64.b64encode(f"{pk.group(1)}:{sk.group(1)}".encode()).decode()
+    from_ts = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(since_ts))
+    query = urllib.parse.urlencode({"name": name, "fromTimestamp": from_ts, "limit": 1})
+    url = host.rstrip("/") + "/api/public/traces?" + query
+    deadline = time.time() + timeout_s
+    while time.time() < deadline:
+        req = urllib.request.Request(url, headers={"Authorization": "Basic " + auth})
+        try:
+            with urllib.request.urlopen(req, timeout=10) as resp:
+                data = json.loads(resp.read().decode())
+            if isinstance(data.get("meta"), dict) and data["meta"].get("totalItems", 0) >= 1:
+                return True
+        except Exception:
+            pass
+        time.sleep(poll_s)
+    return False
+
