# lumen-public-guardian.timer — every 2 minutes (wq#1252).
#
# 2 min is set by the tightest acceptance criterion: stop lumen-pokemon-live
# and the stream must be healed within 4 minutes. One cycle detects and
# restarts, the next confirms. Per-check intervals in config.json throttle the
# expensive checks (probe round trip, DeepSeek balance) inside this cadence.
[Unit]
Description=Lumen public-surface guardian timer (wq#1252)

[Timer]
OnBootSec=2min
OnUnitActiveSec=2min
AccuracySec=15s
RandomizedDelaySec=10s

[Install]
WantedBy=timers.target
