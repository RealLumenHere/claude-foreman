[Unit]
Description=AER-storm leading-indicator alarm for MacPro6,1 nodes (wq#2851)
After=network.target
OnFailure=ntfy-onfailure@%n.service

[Service]
Type=oneshot
User=lumen
ExecStart=/usr/bin/python3 /home/lumen/services/lumen-aer-storm-alarm/aer_storm_alarm.py check
ExecStartPost=-/home/lumen/bin/lumen-cron-stamp %n
TimeoutStartSec=120
