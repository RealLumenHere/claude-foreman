# maat - vault primary. Values as applied 2026-09-29 (wq#3112). Login user maam has PASSWORD sudo.
# Firewall only, never touch listen_addresses. 5432 accepts are the two live streaming standbys (bes, sobek) plus Lumen's ha-monitor probe.
LAN_IFACE=enp2s0
LAN_SUBNET=192.168.8.0/24
DHCPV6=no
EXTRA4=-i enp2s0 -p tcp --dport 5432 -s 192.168.8.177/32 -m comment --comment vault-pg-standby-bes -j ACCEPT
EXTRA4=-i enp2s0 -p tcp --dport 5432 -s 192.168.8.178/32 -m comment --comment vault-pg-standby-sobek -j ACCEPT
EXTRA4=-i enp2s0 -p tcp --dport 5432 -s 192.168.8.160/32 -m comment --comment lumen-ha-monitor-tcp-probe -j ACCEPT
