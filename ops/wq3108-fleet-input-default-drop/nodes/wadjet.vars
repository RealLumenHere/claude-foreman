# wadjet — VAULT HA PAIR (crown jewels). NOPASSWD sudo. Firewall only: never touch
# listen_addresses or any vault config. Apply LAST, after maat is HA-healthy, via
# detached systemd-run (instinct 5). The recon bundle must show which iface/subnet
# carries vault HA replication + peer traffic; put that path in EXTRA rules below
# with the peer as source — do NOT assume it rides tailscale0.
LAN_IFACE=TBD-from-recon
LAN_SUBNET=192.168.8.0/24
DHCPV6=no
# EXTRA4=-i <iface> -p tcp --dport <vault-port> -s <maat-addr>/32 -j ACCEPT  # vault HA peer
