# hathor — plain worker. Confirm the node is actually up first: it has been
# bench/quarantine-cycled (reports/362_hathor_bench_runbook.md).
# LAN_IFACE must come from the recon bundle (ip-addr.txt); genrules refuses TBD.
LAN_IFACE=enp12s0
# Fleet LAN L2 per wq#3089/wq#2808; re-check against recon ip-route.txt.
LAN_SUBNET=192.168.8.0/24
DHCPV6=no
