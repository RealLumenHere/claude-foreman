+def cmd_closure_quality(a):
+    """wq#759: is 'done' backed by evidence, and is that trend improving? Buckets every
+    done ticket by (lane, ISO week of done_at) and classifies its notes with the same
+    find_artifact() the `done` gate itself enforces going forward, so the report and the
+    gate can never silently disagree. Rows closed before the gate existed show up as
+    unverified — that's the audit's own baseline, not a bug."""
+    ping("closure-quality")
+    c = conn()
+    q = "SELECT lane, done_at, notes FROM tasks WHERE status='done' AND done_at IS NOT NULL"
+    params = []
+    if a.lane:
+        q += " AND lane=?"; params.append(a.lane)
+    rows = c.execute(q, params).fetchall(); c.close()
+    cutoff = (utcnow() - datetime.timedelta(weeks=a.weeks)).strftime(FMT)
+    buckets = {}
+    for lane, done_at, notes in rows:
+        if not done_at or done_at < cutoff:
+            continue
+        try:
+            dt = datetime.datetime.strptime(done_at, FMT)
+        except ValueError:
+            continue
+        year, week, _ = dt.isocalendar()
+        key = (lane, f"{year}-W{week:02d}")
+        v, na, u = buckets.get(key, (0, 0, 0))
+        notes = notes or ""
+        if "[NO-ARTIFACT:" in notes:
+            na += 1
+        elif find_artifact(notes)[0]:
+            v += 1
+        else:
+            u += 1
+        buckets[key] = (v, na, u)
+    if not buckets:
+        print(f"(no done tickets with done_at in the last {a.weeks} week(s))"); return
+    print(f"{'lane':<10} {'week':<9} {'done':>5} {'verified':>9} {'no-artifact':>12} {'unverified':>11} {'pct-verified':>13}")
+    for (lane, wk), (v, na, u) in sorted(buckets.items()):
+        total = v + na + u
+        pct = f"{100*v/total:.0f}%" if total else "-"
+        print(f"{lane:<10} {wk:<9} {total:>5} {v:>9} {na:>12} {u:>11} {pct:>13}")
+
