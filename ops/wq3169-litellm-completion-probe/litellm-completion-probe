#!/usr/bin/env python3
"""litellm-completion-probe (wq#3169) — send one real chat completion per
api_base host in litellm_config.yaml, so a dead rung or a key/quota failure
pages before a real request hits it, instead of only after.

WHY THIS EXISTS: lumen-model-check (wq#2903-era) only checks that a model ID
is present in /v1/models — it never sends a completion. That misses a rung
whose api_base is unreachable, whose upstream key expired, or whose quota is
exhausted; those stay invisible until a live caller gets the failure. This
is the completion-level probe that was missing, productionized from the
one-shot audit script at /home/lumen/scratch/audit_20260929/probe2.py.

DESIGN:
  - ONE model probed per api_base host (not every model — a dead host fails
    every model on it identically, so probing more just burns quota).
  - Embed/rerank/whisper/tts deployments are skipped: chat completions is
    the wrong call shape for them.
  - Master key is read from agent/.env with a regex, used only in the
    Authorization header, never printed or logged (instinct 4).
  - Edge-triggered alerting, same contract as litellm-auth-alert (wq#911)
    and health_check_failure_alert (wq#1295): aq add + urgent ntfy on
    clear->breach, aq bump (no re-ntfy) while the breach persists, low-pri
    ntfy on breach->clear. Constant re-alerting trains you to ignore pages.
  - Nothing is printed on a normal run; --print emits a one-line summary
    (for manual/test invocation).

Deploy: see install.sh (script -> /home/lumen/bin, units -> systemd, timer
runs this every 30 min). The .service's ExecStartPost writes the
lumen-cron-stamp dead-man's-switch file so a stopped timer alarms sideways
via lumen-cron-deadman instead of silently going stale.
"""
import argparse
import base64
import concurrent.futures as cf
import json
import os
import pathlib
import re
import subprocess
import sys
import time
import urllib.parse
import urllib.request

# wq#3212: rung enumeration moved to the shared litellm_rungs module so this
# probe and lumen-model-watchdog read the SAME rung list (deployed next to
# this script in /home/lumen/bin; in-repo at ops/wq3212-litellm-dead-rungs/).
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import litellm_rungs

ENV_PATH = os.environ.get("LITELLM_COMPLETION_PROBE_ENV", "/home/lumen/agent/.env")
CONFIG_PATH = os.environ.get("LITELLM_COMPLETION_PROBE_CONFIG", "/home/lumen/agent/litellm_config.yaml")
GATEWAY_URL = os.environ.get("LITELLM_COMPLETION_PROBE_URL", "http://localhost:4000/v1/chat/completions")
STATE_DIR = pathlib.Path(os.environ.get("LITELLM_COMPLETION_PROBE_STATE_DIR", "/home/lumen/agents/litellm-completion-probe"))
NTFY = os.environ.get("LITELLM_COMPLETION_PROBE_NTFY", "/home/lumen/bin/ntfy-send")
NTFY_TOPIC = os.environ.get("LITELLM_COMPLETION_PROBE_TOPIC", "lumen-alerts")
AQ = os.environ.get("LITELLM_COMPLETION_PROBE_AQ", "/home/lumen/bin/aq")
TIMEOUT_S = int(os.environ.get("LITELLM_COMPLETION_PROBE_TIMEOUT_S", "60"))
MAX_TOKENS = int(os.environ.get("LITELLM_COMPLETION_PROBE_MAX_TOKENS", "300"))
WORKERS = int(os.environ.get("LITELLM_COMPLETION_PROBE_WORKERS", "6"))
AQ_DIR = os.environ.get("LITELLM_COMPLETION_PROBE_AQ_DIR", "/home/lumen/agents/alert-queue")

# wq#3221: a 200 completion is not proof Langfuse received it (wq#3211 - 47h of
# LiteLLM->Langfuse traces silently dropped while this exact probe kept passing every
# 30 min, because it only ever checked the HTTP response). Same env file the litellm
# container loads and the same project/trace-name the gateway's callback writes
# (harness/langfuse_trace_rate_monitor.py's DEFAULT_ENV_PATH/DEFAULT_TRACE_NAME).
LANGFUSE_ENV_PATH = os.environ.get("LITELLM_COMPLETION_PROBE_LANGFUSE_ENV", ENV_PATH)
LANGFUSE_HOST = os.environ.get("LITELLM_COMPLETION_PROBE_LANGFUSE_HOST", "http://127.0.0.1:3020")
LANGFUSE_TRACE_NAME = os.environ.get("LITELLM_COMPLETION_PROBE_LANGFUSE_TRACE_NAME", "litellm-acompletion")
LANGFUSE_TRACES_PATH = os.environ.get("LITELLM_COMPLETION_PROBE_LANGFUSE_TRACES_PATH", "/api/public/traces")
LANGFUSE_POLL_TIMEOUT_S = int(os.environ.get("LITELLM_COMPLETION_PROBE_LANGFUSE_TIMEOUT_S", "60"))
LANGFUSE_POLL_INTERVAL_S = int(os.environ.get("LITELLM_COMPLETION_PROBE_LANGFUSE_POLL_S", "5"))
LANGFUSE_TRACE_HOST_KEY = "langfuse-trace-ingest"  # synthetic "host" fed into apply_results

Rung = litellm_rungs.Rung
one_rung_per_host = litellm_rungs.one_rung_per_host


def read_master_key(env_path: str) -> str:
    text = pathlib.Path(env_path).read_text()
    m = re.search(r"LITELLM_MASTER_KEY=(sk-[A-Za-z0-9_-]+)", text)
    if not m:
        raise RuntimeError("LITELLM_MASTER_KEY not found in " + env_path)
    return m.group(1)


def probe_one(key: str, rung: Rung) -> dict:
    body = json.dumps({
        "model": rung.model_name,
        "messages": [{"role": "user", "content": "Reply with the single word: pong"}],
        "max_tokens": MAX_TOKENS,
    }).encode()
    req = urllib.request.Request(
        GATEWAY_URL, body,
        {"Authorization": "Bearer " + key, "Content-Type": "application/json"},
    )
    t0 = time.time()
    try:
        with urllib.request.urlopen(req, timeout=TIMEOUT_S) as resp:
            json.load(resp)
        return {"host": rung.host, "model": rung.model_name, "ok": True,
                "elapsed_s": round(time.time() - t0, 1), "reason": ""}
    except Exception as e:  # noqa: BLE001 - report any failure shape as a probe FAIL
        detail = ""
        try:
            detail = e.read().decode()[:200]  # type: ignore[attr-defined]
        except Exception:
            pass
        reason = (str(e)[:120] + " " + detail).strip().replace("\n", " ")
        return {"host": rung.host, "model": rung.model_name, "ok": False,
                "elapsed_s": round(time.time() - t0, 1), "reason": reason}


def run_probes(key: str, rungs: list) -> list:
    with cf.ThreadPoolExecutor(WORKERS) as ex:
        return [f.result() for f in cf.as_completed([ex.submit(probe_one, key, r) for r in rungs])]


def read_langfuse_creds(env_path: str) -> tuple:
    """Returns (public_key, secret_key), or (None, None) if the file or keys are
    missing. Never printed or logged (instinct 4) - used only in a Basic-auth header."""
    try:
        text = pathlib.Path(env_path).read_text()
    except OSError:
        return None, None
    pk = re.search(r"^LANGFUSE_PUBLIC_KEY=(\S+)$", text, re.M)
    sk = re.search(r"^LANGFUSE_SECRET_KEY=(\S+)$", text, re.M)
    return (pk.group(1) if pk else None, sk.group(1) if sk else None)


def check_langfuse_trace(since_ts: float) -> dict:
    """wq#3221: poll Langfuse's own /api/public/traces for a 'litellm-acompletion'
    trace stamped at/after since_ts, for up to LANGFUSE_POLL_TIMEOUT_S. Shaped as a
    normal probe result dict (host=LANGFUSE_TRACE_HOST_KEY) so it flows through the
    SAME edge-triggered apply_results()/aq/ntfy path a host failure already uses -
    no new alert plumbing, and it gets the same clear->breach/breach->clear discipline.
    A missing-creds skip is reported ok=True (not a probe failure): this check cannot
    tell "callback misconfigured" from "this probe host has no read access to the
    creds file" without the creds it's missing.
    """
    t0 = time.time()
    pk, sk = read_langfuse_creds(LANGFUSE_ENV_PATH)
    if not pk or not sk:
        return {"host": LANGFUSE_TRACE_HOST_KEY, "model": LANGFUSE_TRACE_NAME, "ok": True,
                "elapsed_s": round(time.time() - t0, 1), "reason": "skipped: no langfuse creds"}
    auth = base64.b64encode(f"{pk}:{sk}".encode()).decode()
    from_ts = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(since_ts))
    query = urllib.parse.urlencode({"name": LANGFUSE_TRACE_NAME, "fromTimestamp": from_ts, "limit": 1})
    url = LANGFUSE_HOST.rstrip("/") + LANGFUSE_TRACES_PATH + "?" + query
    deadline = time.time() + LANGFUSE_POLL_TIMEOUT_S
    seen = False
    while time.time() < deadline:
        req = urllib.request.Request(url, headers={"Authorization": "Basic " + auth})
        try:
            with urllib.request.urlopen(req, timeout=10) as resp:
                data = json.load(resp)
            meta = data.get("meta")
            if isinstance(meta, dict) and meta.get("totalItems", 0) >= 1:
                seen = True
                break
        except Exception:
            pass
        if time.time() < deadline:
            time.sleep(LANGFUSE_POLL_INTERVAL_S)
    reason = "" if seen else f"no '{LANGFUSE_TRACE_NAME}' trace within {LANGFUSE_POLL_TIMEOUT_S}s (wq#3211/wq#3221)"
    return {"host": LANGFUSE_TRACE_HOST_KEY, "model": LANGFUSE_TRACE_NAME, "ok": seen,
            "elapsed_s": round(time.time() - t0, 1), "reason": reason}


def _state_path() -> pathlib.Path:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    return STATE_DIR / "state.json"


def _load_state(path: pathlib.Path) -> dict:
    try:
        return json.loads(path.read_text())
    except Exception:
        return {}


def _notify(priority: str, title: str, message: str) -> None:
    if not os.path.exists(NTFY):
        return
    try:
        subprocess.run([NTFY, "-t", NTFY_TOPIC, "-p", priority, "-T", title, "--quiet", message],
                        timeout=15, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass


def _aq_add(key: str, title: str, message: str) -> None:
    if not os.path.exists(AQ):
        return
    try:
        subprocess.run([AQ, "add", "litellm-completion", key, title, message],
                        timeout=15, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass


def _aq_resolve(key: str, why: str) -> None:
    """wq#3212: close our own open row on a recovery edge or when the host left
    the probe set (rung removed from litellm_config.yaml). Without this, a row
    for a removed rung stayed open forever — no probe result ever cleared it.
    Same direct-db shape as lumen_model_watchdog.aq_clear (wq#548 pattern)."""
    try:
        if AQ_DIR not in sys.path:
            sys.path.insert(0, AQ_DIR)
        import aq as _aq
        c = _aq.db()
        ts = _aq.now()
        rows = c.execute("SELECT id FROM alerts WHERE source='litellm-completion' "
                         "AND key=? AND status='open'", (key,)).fetchall()
        for (rid,) in rows:
            c.execute("UPDATE alerts SET status='resolved', note=?, resolved_ts=? "
                      "WHERE id=? AND status='open'",
                      (f"auto-cleared: {why} on {ts} probe run", ts, rid))
        c.commit()
        c.close()
    except Exception:
        pass


def apply_results(results: list) -> dict:
    """Edge-triggered aq/ntfy: alert once per host on clear->breach, bump
    (no re-ntfy) while breached, low-pri notice on breach->clear. Returns the
    new state dict (caller persists it)."""
    path = _state_path()
    state = _load_state(path)
    now_failed = {r["host"]: r for r in results if not r["ok"]}
    for host, r in now_failed.items():
        was_failed = state.get(host, {}).get("failed", False)
        title = f"LiteLLM completion probe: {host} unreachable"
        msg = f"model={r['model']} elapsed={r['elapsed_s']}s reason={r['reason']}"
        _aq_add(host, title, msg)
        if not was_failed:
            _notify("urgent", title, msg)
    for r in results:
        host = r["host"]
        if r["ok"] and state.get(host, {}).get("failed", False):
            _notify("low", f"LiteLLM completion probe: {host} recovered",
                     f"model={r['model']} elapsed={r['elapsed_s']}s")
            _aq_resolve(host, f"{host} recovered (model={r['model']})")
    probed_hosts = {r["host"] for r in results}
    for host, prev in state.items():
        # wq#3212: rung removed from litellm_config.yaml while its row was open
        if host not in probed_hosts and prev.get("failed", False):
            _aq_resolve(host, f"{host} left the probe set (rung removed from config)")
    new_state = {r["host"]: {"failed": not r["ok"], "checked_at": int(time.time())} for r in results}
    return new_state


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--print", action="store_true", dest="do_print")
    args = parser.parse_args()

    key = read_master_key(ENV_PATH)
    rungs = one_rung_per_host(CONFIG_PATH)
    probe_started_at = time.time()
    results = run_probes(key, rungs)
    if any(r["ok"] for r in results):
        # only meaningful once at least one completion actually went through
        results = results + [check_langfuse_trace(probe_started_at)]
    new_state = apply_results(results)
    path = _state_path()
    try:
        path.write_text(json.dumps(new_state))
    except Exception:
        pass

    if args.do_print:
        fails = [r for r in results if not r["ok"]]
        print(f"probed {len(results)} hosts, {len(fails)} failing: "
              + ",".join(r["host"] for r in fails))
    return 0


if __name__ == "__main__":
    sys.exit(main())
