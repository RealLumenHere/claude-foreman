 def _norm(stem): return re.sub(r"_\d{10}$", "", re.sub(r"\.claimed_[a-z]+_\d+$", "", stem))
+
+
+# ── wq#1092: stale-target guard (class fix for the a5-health shape) ────────
+# A probe whose systemd target has been RETIRED (unit file removed --
+# LoadState=not-found) or deliberately masked can never recover via
+# is-active alone: FAIL forever -> CRITICAL forever -> pages Frank forever
+# (aq#899/wq#1064). Every probe that shells out to systemctl for a specific
+# unit MUST call _stale_or_none() first. STALE short-circuits to
+# (ok=True, critical=False) -- structurally unable to reach ntfy_urgent --
+# and files ONE build-lane wq ticket (deduped via state.json) so a human
+# still sees it instead of it silently passing forever.
+PROBE_TICKETS_FILED_KEY = "_stale_probe_tickets"
+WQ_BIN = os.environ.get("SENTINEL_WQ_BIN", "/home/lumen/bin/wq")
+WQ_FILE_CAPTURE = os.environ.get("SENTINEL_WQ_FILE_CAPTURE")  # test hook, same convention as NTFY_UPDATES_CAPTURE
+
+def _unit_load_state(unit):
+    try:
+        r = subprocess.run(["systemctl", "show", unit, "-p", "LoadState"],
+                           capture_output=True, text=True, timeout=10)
+        return dict(l.split("=", 1) for l in r.stdout.strip().splitlines() if "=" in l).get("LoadState", "not-found")
+    except Exception:
+        return "not-found"
+
+def _file_stale_probe_ticket(probe_name, unit, load_state):
+    s = _state()
+    filed = s.setdefault(PROBE_TICKETS_FILED_KEY, {})
+    key = f"{probe_name}:{unit}"
+    if key in filed:
+        return
+    title = f"[monitor] {probe_name} targets retired unit {unit} ({load_state}) -- remove or retarget probe"
+    detail = (f"{probe_name} in sentinel_probes.py checks systemd unit '{unit}' but "
+              f"LoadState={load_state} -- the unit no longer exists to watch. Auto-detected "
+              f"by the wq#1092 stale-target guard (was CRITICAL-forever/false-page shape, "
+              f"see wq#1064/aq#899). Comment out or retarget the probe.")
+    if WQ_FILE_CAPTURE:
+        try:
+            with open(WQ_FILE_CAPTURE, "a") as fh:
+                fh.write(json.dumps({"probe": probe_name, "unit": unit, "load_state": load_state,
+                                      "title": title}) + "\n")
+        except Exception as e:
+            print(f"stale-probe ticket capture failed: {e}")
+    else:
+        try:
+            subprocess.run([WQ_BIN, "add", "--lane", "build", "--pri", "2",
+                            "--title", title, "--detail", detail],
+                           capture_output=True, text=True, timeout=20)
+        except Exception as e:
+            print(f"stale-probe ticket file failed (non-fatal): {e}")
+    filed[key] = time.time()
+    _save(s)
+
+def _stale_or_none(unit, probe_name):
+    """Returns a (ok, detail, critical) STALE tuple if unit is not-found/masked,
+    else None -- caller proceeds with its normal is-active/ActiveState logic."""
+    load = _unit_load_state(unit)
+    if load in ("not-found", "masked"):
+        _file_stale_probe_ticket(probe_name, unit, load)
+        return True, f"STALE TARGET: {unit} LoadState={load} (build ticket filed, never pages)", False
+    return None
 
