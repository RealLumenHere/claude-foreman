+def _phrase_in(q_seq, phrase_words):
+    """True when `phrase_words` appears contiguously, on word boundaries, in `q_seq`."""
+    n = len(phrase_words)
+    if not n:
+        return False
+    return any(q_seq[i:i + n] == phrase_words for i in range(len(q_seq) - n + 1))
