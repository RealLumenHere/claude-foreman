s#(<[A-Za-z0-9._-]*(SECRET|TOKEN|KEY|CREDENTIALS?|PASSPHRASE|PASSWORD|PASSWD|PASS|SALT)[A-Za-z0-9._-]*>)[^<[:space:]]{8,}(</)#\1\x01\3#gI
s/((TOKEN|SECRET|PASSWORD|PASSWD|PASSPHRASE|PASS|SALT|CREDENTIALS?)["'\''[:space:]]*[:=]["'\''[:space:]]*)[A-Za-z0-9._+\/=:!#$%^*@~-]{8,}/\1\x01/gI
