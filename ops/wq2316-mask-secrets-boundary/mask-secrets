#!/bin/bash
# Pipe grep/cat/env output through this to redact secret VALUES before they hit a transcript.
# Usage: grep -rn GITHUB_TOKEN /home/lumen/agent | mask-secrets
#
# wq#2913/wq#3825: a WRAPPER around harness/masking.py's mask_text(), not a hand-ported
# copy of its PATTERNS table. The sed re-implementation that used to live here (POSIX
# ERE, no lookaround) could not express every lookahead masking.py's rules carry — the
# mask-literal sentinel, the DSN pointer/placeholder exclusions, the `(?<=_)pass`
# boundary kv-secret's bare noun needs — and every attempt to hand-port one of those
# drifted from the original the next time either side changed: wq#2726 -> wq#2732
# shipped an actual leak to bin/, and wq#3825 found eight parity-test failures where
# this file and masking.py disagreed again, plus five token families (JWT, Bearer,
# AIza, tskey-, gsk_) that bin/mask-secrets, handle-store.js and Horus redact.js had
# all learned from wq#3716 and masking.py never did — the fourth copy the lockstep
# missed. Importing masking.py directly instead of re-deriving its rules in ERE makes
# that whole class of drift structurally impossible: there is one implementation, and
# this is it, run from a different entry point.
#
# Resolution order for harness/masking.py: beside this bundle first (the repo/worktree
# checkout this bundle's own test suite runs against), then the fleet's canonical
# checkout (/home/lumen/foreman/harness) — install.sh deploys THIS file alone, with no
# harness/ sibling, so the deployed copy at /home/lumen/bin/mask-secrets needs the
# fixed fallback path to find its rules.
set -euo pipefail

_HERE="$(cd "$(dirname "$0")" && pwd)"

exec python3 -c '
import importlib.util
import pathlib
import sys

here = pathlib.Path(sys.argv[1])
candidates = (here.parents[1] / "harness" / "masking.py",
              pathlib.Path("/home/lumen/foreman/harness/masking.py"))
for masking_py in candidates:
    if masking_py.exists():
        break
else:
    sys.exit("mask-secrets: harness/masking.py not found in %r" % (candidates,))

sys.path.insert(0, str(masking_py.parent))
spec = importlib.util.spec_from_file_location("masking", masking_py)
masking = importlib.util.module_from_spec(spec)
spec.loader.exec_module(masking)
masking.main(sys.stdin, sys.stdout)
' "$_HERE"
