#!/bin/bash
# Pipe grep/cat/env output through this to redact secret VALUES before they hit a
# transcript.  Usage: grep -rn GITHUB_TOKEN /home/lumen/agent | mask-secrets
#
# wq#2913: this is now a WRAPPER around harness/masking.py (`masking.main`), not a
# second implementation of the house rule set.
#
# What it replaced: a sed -E program that mirrored masking.PATTERNS by hand. POSIX
# ERE has no lookaround, so every lookahead in the Python rules had to be
# re-expressed structurally here — the mask literal swapped for a sentinel byte no
# charset contains, the wq#2720 foreign-prefix stop as a second sentinel byte marked
# and swept per rule, wq#2848's floor-relative window as a `{N}` run admitting the
# mark, wq#2899's absorb as one more substitution per rule, the whole program run six
# times over for wq#2720's multi-pass — around thirty substitutions expressing nine
# rules. The copy drifted from masking.py on every one of those tickets, always in
# the direction that misses a mask: ISSUE-LOG row 577 records it missing two earlier
# fixes outright, and wq#2726 -> wq#2732 shipped a real leak to /home/lumen/bin
# (a value ending in punctuation, and a value sitting exactly at its floor, both in
# the clear). wq#2913 removed the stop-based design this copy was mirroring, which
# would have meant re-deriving all of it a fourth time. One implementation instead.
#
# Every behaviour the sed program had a comment for lives in harness/masking.py now:
# the word boundary (wq#2292/wq#2294/wq#2400), the mask-literal guard (wq#2638), the
# url-auth and XML rules (wq#2514/wq#2760/wq#2806), the kv-secret label grammar and
# its suppressions (wq#2297/wq#2632/wq#2677/wq#2806). The known divergences are gone
# with the copy: this tool now masks exactly what the tripwire pages on.
#
# Fails CLOSED. If the masker is not readable it prints nothing and exits non-zero,
# because a mask-secrets that passes text through is worse than one that is missing —
# the caller piped through it precisely so a credential would not reach the terminal.
set -uo pipefail

# The bundle's own harness first, so a worktree tests the masker on ITS branch and
# not whatever is deployed; then an explicit override; then the deployed tree, which
# is what the installed copy at /home/lumen/bin/mask-secrets resolves to.
_here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
for _dir in "$_here/../../harness" "${LUMEN_MASKER_HOME:-}" /home/lumen/foreman/harness; do
  if [ -n "$_dir" ] && [ -r "$_dir/masking.py" ]; then
    MASKER_HOME="$_dir"
    break
  fi
done

if [ -z "${MASKER_HOME:-}" ]; then
  echo "mask-secrets: no masking.py found — refusing to pass input through unmasked" >&2
  echo "mask-secrets: set LUMEN_MASKER_HOME to the harness directory holding it" >&2
  exit 1
fi

# Called as a function rather than run as a script on purpose: a masking.py too old
# to have `main` raises AttributeError here and exits non-zero, where `python3
# masking.py` against the same file would exit 0 having printed nothing — a
# mask-secrets that silently swallows its input is the one failure this tool cannot
# have. `errors="replace"` because a log tail or a `cat` of a binary is not
# guaranteed UTF-8, and a masker that dies on one byte hides everything after it.
exec python3 -c 'import sys
sys.path.insert(0, sys.argv[1])
import masking
sys.stdin.reconfigure(errors="replace")
sys.stdout.reconfigure(errors="replace")
sys.exit(masking.main(sys.stdin, sys.stdout))' "$MASKER_HOME"
