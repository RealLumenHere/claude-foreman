# Limpet flash programmer udev rules
# CH341A USB SPI programmer
SUBSYSTEM=="usb", ATTR{idVendor}=="1a86", ATTR{idProduct}=="5512", MODE="0666", GROUP="plugdev", TAG+="limpet-programmer"
# XGecu TL866II+ / T48
SUBSYSTEM=="usb", ATTR{idVendor}=="04d8", ATTR{idProduct}=="e11c", MODE="0666", GROUP="plugdev", TAG+="limpet-programmer"
# Raspberry Pi Pico (serprog firmware)
SUBSYSTEM=="tty", ATTRS{idVendor}=="2e8a", ATTRS{idProduct}=="000a", MODE="0666", GROUP="plugdev", TAG+="limpet-programmer", SYMLINK+="limpet-pico-serprog"
