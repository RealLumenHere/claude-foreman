# runtime state / governor artifacts — not source
/state.json
/STOP
/events.json
/events/
/dispatcher/state.json
/dispatcher.log

# wq#1905: per-ticket evidence-gate claim, not source — every worker writes these at the
# worktree root, and this worktree IS the foreman repo, so tracking them meant every
# ticket's evidence clobbered the last one's on main (82 commits touching evidence.json
# alone). The run dir (RUNS_ROOT/wq<id>, never git-tracked) is authoritative now;
# acceptance.py's read_acceptance/read_evidence fall back to these worktree copies only
# when the run dir copy is unreachable.
/acceptance.json
/evidence.json

# scratch from probe runs and interim dispatch spawns — not source
/_probe/
/_runs/
*.bak.*
*.bak

# interim dispatch scaffolding, superseded once T2a lands
/FOREMAN_DISPATCH.md
/FOREMAN_DISPATCH.prompt
/worker-settings-interim.json

# python
__pycache__/
*.pyc
.pytest_cache/

# claude-shim runtime secret — generated per-install, never committed (wq#726)
/claude-shim/.api_key
ops/systemd-desired-state/

# per-daemon health/self-heal runtime state (wq#1012 split) — not source
/dispatcher_health/
/self_heal/
/self_heal.log
/self_heal.log.*.gz
/dispatcher.log.*.gz
/ops/intervention_ledger.db
/scribe.db

# wq#1253 (#23): all mutable dispatcher runtime state lives under runtime/ dirs,
# gitignored, so lumen-pr's dirty-tree guard never false-blocks a land on a daemon's
# own state writes. config.json stays tracked and static (wq#772).
runtime/
*.err
.*.err

# systemd unit backups dropped beside the plans that generated them (wq#997).
# The *.bak / *.bak.* patterns above miss the -service / -timer suffixes.
*.bak-*

# wq#1300: generated eval dataset/results — regenerated each run, not source
/harness/evals/worker-quality/runtime/

# wq#1991: local output of ops/wq1991-worktree-module-identity/verify_5x.py — one
# full-suite transcript per repeat, regenerated on demand, never source.
/.wq1991-verify/
/.wq1991-verify.log

# wq#2543/wq#2549: mask_replay.py's rotated-value ledger — runtime state (hashes,
# timestamps, tickets, notes; never a raw value), not source.
/rotated_ledger.json

# wq#2575: reports/research are markdown source; ad-hoc .txt run dumps are scratch
/reports/*.txt
/research/*.txt

# wq#3759: sandbox gate runtime — proposals in flight and the evidence they produce
/research/proposals/
/research/evidence/

# wq#2575: dispatch janitor runtime log/state, regenerated each run — not source
/dispatch_janitor.log
/dispatch_janitor/

# wq#2575: real per-install secret env; committed template is lumen-despag.env.example
/harness/systemd/lumen-despag.env

