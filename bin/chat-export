#!/usr/bin/env python3
"""chat-export - parse claude.ai <chat> blocks (recent_chats / conversation_search output) into
a JSON archive, merging across paginated calls.

Same input contract as /home/lumen/bin/chat-digest: Lumen cannot log in to claude.ai, so this
CLI does not fetch chats itself. The browser Claude pages recent_chats and pipes each page's

  <chat url="https://claude.ai/chat/<uuid>" updated_at="..." kind="summary|conversation"
        page_token="..."> body </chat>

blocks here, one call per page. chat-export merges newly-seen chats into the archive file by id:
a chat not yet archived is added, an archived chat whose updated_at is newer is replaced, and
everything else is left untouched. Repeated calls across a full paginated recent_chats walk
converge on one deduplicated archive without reprocessing history already captured. Unlike
chat-digest (lossy keyword extraction), the archive keeps the full chat body, masked.

  chat-export < page1.txt                       # merges into ~/.chat-archive/archive.json
  chat-export --archive out.json < page2.txt
  chat-export --print                           # dump the merged archive as-is

The merge report on stdout (added/updated/unchanged counts + the last page_token seen) tells a
paginating caller whether to keep walking recent_chats or stop: an all-unchanged page with no new
page_token means the archive is caught up.

Anything shaped like a credential is replaced by <redacted> before it ever reaches disk (same
patterns as chat-digest: cf*_ tokens, github_pat_, sk-..., Bearer, long hex/base64, JWT,
password= values). Masking is per-field and on by default: every string field of a chat record
is masked except the ones named in OPAQUE_FIELDS, so a field added later is redacted unless
someone deliberately exempts it.

Exit: 0 ok, 2 usage / no input.
"""
import argparse
import html
import json
import os
import re
import sys
import tempfile

UUID_RE = re.compile(r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}", re.I)
CHAT_RE = re.compile(r"<chat\s+([^>]*)>(.*?)</chat>", re.S)
ATTR_RE = re.compile(r"(\w+)\s*=\s*([\"'])(.*?)\2", re.S)

SECRET_RES = [
    re.compile(r"\bcf[a-z]{2}_[A-Za-z0-9_-]{20,}"),
    re.compile(r"\bgithub_pat_[A-Za-z0-9_]{20,}"),
    re.compile(r"\bgh[pousr]_[A-Za-z0-9]{20,}"),
    re.compile(r"\bsk-[A-Za-z0-9_-]{16,}"),
    re.compile(r"\bAKIA[0-9A-Z]{16}\b"),
    re.compile(r"\beyJ[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{8,}"),
    re.compile(r"(?i)\bBearer\s+[A-Za-z0-9._~+/=-]{16,}"),
    re.compile(r"\b[0-9a-f]{40,}\b"),
    re.compile(r"(?<![\w/.-])(?=[A-Za-z0-9_-]*\d)(?=[A-Za-z0-9_-]*[A-Za-z])[A-Za-z0-9_-]{40,}={0,2}(?![\w/.-])"),
]
KV_RE = re.compile(r"(?i)\b(password|passwd|pw|secret|token|api[_-]?key)(\s*[=:]\s*)\S+")

DEFAULT_ARCHIVE = os.path.expanduser("~/.chat-archive/archive.json")

# Fields exempt from masking because their value is an opaque upstream cursor that has to
# round-trip verbatim. `page_token` is a real one: a 40+ char base64-ish token matches
# SECRET_RES's trailing long-token rule, and a redacted token is the value the merge report
# hands back as last_page_token, so masking it stalls the paginated recent_chats walk.
# `id` is not listed: it is derived from UUID_RE, which cannot match any pattern here.
OPAQUE_FIELDS = frozenset({"page_token"})


def mask(s):
    s = KV_RE.sub(lambda m: m.group(1) + m.group(2) + "<redacted>", s)
    for rx in SECRET_RES:
        s = rx.sub("<redacted>", s)
    return s


def mask_block(block):
    """Mask every string field of a chat record except the declared-opaque ones.

    Per-field opt-out, not opt-in: wq#3332 masked `body` at its one construction site and
    left `title` and `url` — both derived from the same freeform chat text — in plaintext,
    because each field had to be remembered individually (wq#3343 CONTRADICT, wq#3355).
    Defaulting to masked means the next field someone adds is safe by omission.
    """
    return {k: mask(v) if isinstance(v, str) and k not in OPAQUE_FIELDS else v
            for k, v in block.items()}


def parse_blocks(text):
    blocks = []
    for m in CHAT_RE.finditer(text):
        attrs = {k: v for k, _q, v in ATTR_RE.findall(m.group(1))}
        url = attrs.get("url", "")
        u = UUID_RE.search(url)
        body = html.unescape(m.group(2).strip("\n"))
        title = ""
        tm = re.match(r"\s*Title:\s*(.+)", body)
        if tm:
            title = tm.group(1).strip()
        blocks.append(mask_block({
            "id": u.group(0).lower() if u else "",   # read off the raw url, before masking
            "url": url,
            "updated_at": attrs.get("updated_at", ""),
            "kind": attrs.get("kind", "conversation"),
            "page_token": attrs.get("page_token", ""),
            "title": title,
            "body": body,
        }))
    return blocks


def load_archive(path):
    if not os.path.exists(path):
        return {}
    with open(path) as f:
        data = json.load(f)
    return {c["id"]: c for c in data.get("chats", []) if c.get("id")}


def archive_payload(by_id):
    """The archive's output form: masked, newest first.

    Every path that lets a chat record leave this process — the archive file and --print —
    goes through here, so the masking promise holds even for records this run did not parse:
    an archive written by a build that stored `title` unmasked is healed on the next write.
    """
    return {"chats": sorted((mask_block(c) for c in by_id.values()),
                             key=lambda c: c.get("updated_at", ""), reverse=True)}


def save_archive(path, by_id):
    os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path) or ".", prefix=".chat-export-")
    try:
        with os.fdopen(fd, "w") as f:
            json.dump(archive_payload(by_id), f, indent=2)
        os.replace(tmp, path)
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)


def merge(by_id, blocks):
    added = updated = unchanged = skipped = 0
    last_page_token = ""
    for b in blocks:
        if b["page_token"]:
            last_page_token = b["page_token"]
        if not b["id"]:
            skipped += 1
            continue
        existing = by_id.get(b["id"])
        if existing is None:
            by_id[b["id"]] = b
            added += 1
        elif b["updated_at"] and b["updated_at"] > existing.get("updated_at", ""):
            by_id[b["id"]] = b
            updated += 1
        else:
            unchanged += 1
    return {"added": added, "updated": updated, "unchanged": unchanged, "skipped": skipped,
            "last_page_token": last_page_token, "total": len(by_id)}


def main(argv=None):
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0],
                                  epilog=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--archive", default=DEFAULT_ARCHIVE, help="archive JSON path (default %(default)s)")
    ap.add_argument("--file", "-f", help="read a recent_chats/conversation_search page from this file")
    ap.add_argument("--print", dest="print_archive", action="store_true", help="dump the merged archive and exit")
    ap.add_argument("--dry-run", action="store_true", help="report the merge without writing the archive")
    a = ap.parse_args(argv)

    by_id = load_archive(a.archive)

    if a.print_archive:
        print(json.dumps(archive_payload(by_id), indent=2))
        return 0

    if a.file:
        text = open(a.file, errors="replace").read()
    elif sys.stdin.isatty():
        print("chat-export: no input. Pipe a recent_chats/conversation_search page on stdin or use --file "
              "(Lumen cannot fetch claude.ai chats itself).", file=sys.stderr)
        return 2
    else:
        text = sys.stdin.read()

    blocks = parse_blocks(text)
    if not blocks:
        print("chat-export: no <chat> blocks in input", file=sys.stderr)
        return 2

    report = merge(by_id, blocks)
    if not a.dry_run:
        save_archive(a.archive, by_id)
    report["archive"] = a.archive
    report["dry_run"] = a.dry_run
    print(json.dumps(report, indent=2))
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except BrokenPipeError:
        sys.exit(0)
