# lumen-foreman-window-gate.timer — Thursday pre-Max-reset gate (wq#1411 §4).
# The weekly Max reset lands Thu ~04:00 PT (governor limits.weekly_all.resets_at);
# 00:30 PT leaves time to fix what the gate finds before the window opens.
# systemd honours the TZ suffix — verified: `systemd-analyze calendar
# 'Thu 00:30 America/Los_Angeles'` normalizes and tracks DST on this box.
[Unit]
Description=Thu 00:30 PT pre-reset dispatch gate (wq#1411)

[Timer]
OnCalendar=Thu 00:30 America/Los_Angeles
Unit=lumen-foreman-gate@window.service
AccuracySec=1min
Persistent=false

[Install]
WantedBy=timers.target
