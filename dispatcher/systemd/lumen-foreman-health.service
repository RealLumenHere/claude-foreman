# lumen-foreman-health.service — one dispatch health check (wq#825).
# Reads the dispatcher log, classifies last N passes, ntfys Frank URGENT
# if all are unhealthy. Replaces the interim dispatch-deadman.sh.
[Unit]
Description=Lumen dispatcher health check — alarm on consecutive stalled passes (wq#825)
Documentation=file:///home/lumen/foreman/dispatcher/dispatch_health.py
After=network-online.target

[Service]
Type=oneshot
User=lumen
Environment=PATH=/home/lumen/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=/home/lumen/foreman
ExecStart=/usr/bin/python3 /home/lumen/foreman/dispatcher/dispatch_health.py check
TimeoutStartSec=60
Nice=5
