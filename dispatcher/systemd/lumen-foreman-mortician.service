# lumen-foreman-mortician.service — one terminal-failure triage pass (wq#2486).
# STAGED (Tier-3): installed but never enabled by the fleet; the timer is the only starter.
# See dispatcher/mortician.py's module docstring and dispatcher/systemd/INSTALL.md.
# Deliberately no [Install] section: this service cannot be enabled at boot, only started by
# the timer (or manually for a one-off pass).
[Unit]
Description=Lumen mortician — classify terminally-failed wq rows once, record the lesson, mark do-not-redispatch (wq#2486)
Documentation=file:///home/lumen/foreman/dispatcher/mortician.py
After=network-online.target

[Service]
Type=oneshot
User=lumen
# wq lives in /home/lumen/bin.
Environment=PATH=/home/lumen/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=/home/lumen/foreman
ExecStart=/usr/bin/python3 /home/lumen/foreman/dispatcher/mortician.py
# Dead-man's-switch stamp (wq#1184) — non-fatal (`-`) so a stamp-write hiccup never fails the pass.
ExecStartPost=-/home/lumen/bin/lumen-cron-stamp %n
TimeoutStartSec=300
Nice=10
