# lumen-foreman-health-thu.timer — 5-min cadence, Thursday 01:00-09:00 America/
# Los_Angeles only: the Max-reset watch window (wq#1411, research/
# NIGHTLY_DISPATCH_RESILIENCE.md §4). Runs alongside (not instead of) the ordinary
# lumen-foreman-health.timer — this is the tightened second instance, not a
# replacement. SHIPS DISABLED (Tier-3, same posture as the other foreman timers):
# nothing runs until Frank runs
# `systemctl enable --now lumen-foreman-health-thu.timer` himself.
[Unit]
Description=Thursday Max-reset window dispatcher health watch, K=1/20min dedup (STAGED — Frank enables; wq#1411)

[Timer]
OnCalendar=Thu *-*-* 01..08:00/5:00 America/Los_Angeles
OnCalendar=Thu *-*-* 09:00:00 America/Los_Angeles
RandomizedDelaySec=15
Persistent=false

[Install]
WantedBy=timers.target
