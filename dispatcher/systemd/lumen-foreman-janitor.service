# lumen-foreman-janitor.service — one dispatch-janitor pass (DISPATCH_REBUILD step 11, wq#2134).
# STAGED (Tier-3): installed but never enabled by the fleet; the timer is the only starter.
# See dispatcher/dispatch_janitor.py's module docstring and dispatcher/systemd/INSTALL.md.
# Deliberately no [Install] section: this service cannot be enabled at boot, only started by
# the timer (or manually for a one-off pass).
[Unit]
Description=Lumen dispatch janitor — release RUNG_FAULT blocks, relane, clear stale holds, daily digest (wq#2134)
Documentation=file:///home/lumen/foreman/dispatcher/dispatch_janitor.py
After=network-online.target

[Service]
Type=oneshot
User=lumen
# wq / slock / aq live in /home/lumen/bin.
Environment=PATH=/home/lumen/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=/home/lumen/foreman
ExecStart=/usr/bin/python3 /home/lumen/foreman/dispatcher/dispatch_janitor.py run --once
# Dead-man's-switch stamp (wq#1184) — non-fatal (`-`) so a stamp-write hiccup never fails the pass.
ExecStartPost=-/home/lumen/bin/lumen-cron-stamp %n
TimeoutStartSec=300
Nice=5
