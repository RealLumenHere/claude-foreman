#!/usr/bin/env python3
"""git-credential-token-engine — git's credential helper on the token-engine
socket (wq#2271, TOKEN_ENGINE_DESIGN.md §3.1).

Forwards git's credential `get` line protocol (protocol=/host=/path= in,
username=/password= out) to the broker as the `git-credential` verb. The
daemon answers with a one-shot handoff FILE path (the gateway-key pattern) —
never the value in the frame — and this helper reads the file, unlinks it,
and hands username/password to git on stdout. `store` and `erase` are no-ops:
this helper never writes a credential anywhere, so nothing can land in
~/.git-credentials, git config, env, or shell history.

Installed as /usr/local/bin/git-credential-token-engine by
token-engine/install.sh; selected per worktree by the harness via
`credential.helper=token-engine` + `credential.useHttpPath=true` (the path is
how the slug is derived, so the daemon can scope per repo, not per host).

The grant is self-attested per invocation — the lumen-pr T4 pattern (T2 trust
model: the broker's enforced value is the audit line, the daemon-side forge
pinning, and the value-free frame). Scoped to kind git_read on exactly this
repo's node, TTL 15 min, removed before exit.

A failure prints one rule-tagged line to stderr and exits 1: git treats a
failed helper as "no credential" and the fetch/push fails with a clean 401
instead of a prompt (the worktree config carries no other helper).
"""

import hashlib
import json
import os
import re
import shutil
import socket
import sys
import tempfile
import time

SOCK = os.environ.get("TOKEN_ENGINE_SOCK", "/run/token-engine/broker.sock")
# Under the events tree, not /tmp: the daemon's PrivateTmp hides /tmp, and
# events/ carries a default ACL uid tokeneng can read through (lumen-pr:90).
GRANT_DIR = os.environ.get("TOKEN_ENGINE_GRANT_DIR", "/home/lumen/foreman/events")
SLUG_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9][A-Za-z0-9._-]*$")


def fail(rule, detail=""):
    sys.stderr.write("git-credential-token-engine: %s%s\n"
                     % (rule, " — " + detail if detail else ""))
    sys.exit(1)


def identity():
    """(ticket, worker) for the audit line — fworker env when present, an
    explicit adhoc marker otherwise. Never a guess (lumen-pr te_identity)."""
    ticket = os.environ.get("FOREMAN_TICKET_ID", "").strip()
    if not ticket:
        agent = os.environ.get("WQ_AGENT", "")
        m = re.match(r"^fworker-wq([0-9]+)$", agent)
        ticket = "wq" + m.group(1) if m else "adhoc-git"
    worker = re.sub(r"[^A-Za-z0-9._-]", "",
                    os.environ.get("FOREMAN_WORKER", "")
                    or os.environ.get("WQ_AGENT", "")) or "git-cred-%d" % os.getpid()
    return ticket, worker[:64]


def parse_request(stdin):
    attrs = {}
    for line in stdin:
        line = line.rstrip("\n")
        if not line:
            break
        if "=" in line:
            k, v = line.split("=", 1)
            attrs[k] = v
    return attrs


def slug_from_path(path):
    """owner/name from the credential request's path attribute. Present only
    because the harness sets credential.useHttpPath=true; without it the
    daemon could not scope per repo, so refuse rather than guess."""
    slug = path.strip("/")
    if slug.endswith(".git"):
        slug = slug[:-4]
    return slug if SLUG_RE.match(slug) else None


def broker_call(req):
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(30)
    try:
        s.connect(SOCK)
        s.sendall((json.dumps(req) + "\n").encode())
        buf = b""
        while b"\n" not in buf:
            chunk = s.recv(4096)
            if not chunk:
                break
            buf += chunk
    finally:
        s.close()
    return json.loads(buf.split(b"\n", 1)[0].decode())


def get(attrs):
    protocol, host, path = (attrs.get("protocol", ""), attrs.get("host", ""),
                            attrs.get("path", ""))
    if not (protocol and host):
        fail("request_malformed", "no protocol/host from git")
    slug = slug_from_path(path)
    if not slug:
        fail("path_unusable",
             "no owner/repo path in the request — is credential.useHttpPath "
             "set true in this worktree?")
    ticket, worker = identity()
    gdir = tempfile.mkdtemp(prefix="te-cred.", dir=GRANT_DIR)
    try:
        os.chmod(gdir, 0o755)
        expires = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(time.time() + 900))
        grant = json.dumps({"ticket": ticket, "expires": expires,
                            "grants": [{"kind": "git_read",
                                        "node": "repo:" + slug}]}).encode()
        gpath = os.path.join(gdir, "grant.json")
        with open(gpath, "wb") as f:
            f.write(grant)
        os.chmod(gpath, 0o644)
        try:
            frame = broker_call({"verb": "git-credential",
                                 "argv": [slug, protocol, host],
                                 "ticket": ticket, "attempt": 1, "worker": worker,
                                 "grant_file": gpath,
                                 "grant_sha": hashlib.sha256(grant).hexdigest()})
        except (OSError, ValueError) as e:
            fail("broker_unreachable", "%s on %s" % (type(e).__name__, SOCK))
        if not frame.get("ok"):
            fail(str(frame.get("rule", "denied")), str(frame.get("reason", "")))
        result = frame.get("result") or {}
        cred_file = str(result.get("credential_file", ""))
        try:
            with open(cred_file) as f:
                password = f.read().strip()
        finally:
            # One-shot: gone the moment it is read, even if the print fails.
            try:
                os.unlink(cred_file)
            except OSError:
                pass
        if not password:
            fail("handoff_empty", "daemon handoff carried no value")
        sys.stdout.write("username=%s\n" % result.get("username", ""))
        sys.stdout.write("password=%s\n" % password)
    finally:
        shutil.rmtree(gdir, ignore_errors=True)


def main():
    action = sys.argv[1] if len(sys.argv) > 1 else ""
    attrs = parse_request(sys.stdin)
    if action == "get":
        get(attrs)
    # store/erase: deliberate no-ops — nothing to persist, nothing persisted.


if __name__ == "__main__":
    main()
