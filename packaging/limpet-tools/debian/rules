#!/usr/bin/make -f
# wq#3947: stages limpet/{cli,daemon,registry,registry_core,manifest,health}.py
# into the package tree. This package root carries no copy of them on disk;
# the build always reads whatever is currently checked in at those paths.

MONOROOT := $(CURDIR)/../..
SRC := $(MONOROOT)/limpet
PKGROOT := debian/limpet-tools

%:
	dh $@

override_dh_installsystemd:
	# Ships disabled: enabling the reconcile loop before any plugin is
	# dropped into /etc/limpet/plugins.d just reconciles an empty registry
	# on a timer. Operator opts in once a plugin exists.
	#
	# wq#4071: the unit is limpet-registry-daemon.service but the binary
	# package is limpet-tools. dh_installsystemd only auto-discovers
	# debian/<package>.service and debian/<package>.<name>.service, so the
	# source file is debian/limpet-tools.limpet-registry-daemon.service and
	# --name selects it; it installs as limpet-registry-daemon.service, the
	# canonical name (docs/limpet-naming.md; limpet-mcp-meta Requires= it).
	dh_installsystemd --no-enable --no-start --name=limpet-registry-daemon

override_dh_auto_install:
	dh_auto_install
	install -d $(PKGROOT)/usr/lib/limpet/tools
	install -m 0644 $(SRC)/cli.py $(SRC)/daemon.py $(SRC)/registry.py \
	    $(SRC)/registry_core.py $(SRC)/manifest.py $(SRC)/health.py \
	    $(SRC)/workspace_cli.py $(SRC)/workspace_report.py \
	    $(PKGROOT)/usr/lib/limpet/tools/
	# wq#3934: built-in report templates live next to workspace_report.py so
	# BUILTIN_TEMPLATES_DIR resolves; /etc/limpet/report-templates is the site
	# drop-in for operator-authored custom formats.
	cp -r $(SRC)/report-templates $(PKGROOT)/usr/lib/limpet/tools/
	install -d $(PKGROOT)/etc/limpet/plugins.d
	install -d $(PKGROOT)/etc/limpet/report-templates
	install -d $(PKGROOT)/var/lib/limpet
