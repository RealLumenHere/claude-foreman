[Unit]
Description=remote-cli shared-PTY terminal daemon

[Service]
Type=simple
ExecStart=/usr/bin/remote-cli serve --control-socket /run/remote-cli/shared.sock --attach-socket /run/remote-cli/attach.sock
RuntimeDirectory=remote-cli
RuntimeDirectoryMode=0777
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
