{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lumen.industries/limpet/plugin-manifest.schema.json",
  "title": "Limpet plugin manifest (limpet-plugin.toml, parsed to JSON)",
  "description": "Schema for a Limpet tool/hardware plugin manifest. Formalizes the limpet-plugin.toml format from projects/limpet/VISION.md. The registry loader (design/wq3806_limpet_architecture.md §1) rejects any manifest that fails this schema. The required `trust` tier is the security spine: only core/vetted plugins may be enabled; community plugins are visible but inert until promoted.",
  "type": "object",
  "required": ["plugin", "trust"],
  "additionalProperties": false,
  "properties": {
    "plugin": {
      "type": "object",
      "required": ["name", "version", "category"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
        "version": { "type": "string", "minLength": 1 },
        "category": {
          "type": "string",
          "enum": [
            "binary-analysis",
            "disassembler",
            "decompiler",
            "firmware",
            "emulation",
            "debugger",
            "mobile",
            "web",
            "network",
            "crypto",
            "hardware",
            "forensics",
            "other"
          ]
        },
        "description": { "type": "string" }
      }
    },
    "trust": {
      "description": "Trust tier. core=audited, shipped in base image, enabled by default. vetted=passed the TOOL_REGISTRY go/no-go (pinned, source-read, scoped). community=present but inert until promoted by review; the meta-server refuses to proxy a community tool call.",
      "type": "string",
      "enum": ["core", "vetted", "community"]
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": { "type": ["boolean", "string", "array"] },
      "properties": {
        "architectures": { "type": "array", "items": { "type": "string" } },
        "input_formats": { "type": "array", "items": { "type": "string" } },
        "output_formats": { "type": "array", "items": { "type": "string" } }
      }
    },
    "mcp": {
      "type": "object",
      "required": ["enabled"],
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "server": { "type": "string" },
        "transport": { "type": "string", "enum": ["stdio", "http", "sse"] }
      },
      "if": { "properties": { "enabled": { "const": true } } },
      "then": { "required": ["server", "transport"] }
    },
    "paths": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "health": {
      "type": "object",
      "required": ["check"],
      "additionalProperties": false,
      "properties": {
        "check": { "type": "string", "minLength": 1 },
        "interval": { "type": "string", "pattern": "^[0-9]+[smhd]$" }
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requires": { "type": "array", "items": { "type": "string" } }
      }
    },
    "integrity": {
      "description": "wq#4056 supply-chain trust gate: pinned content hash of the plugin payload tree, verified at install AND load. Absent = verification state 'unverified' (visible warning, explicit opt-in to load). A present-but-mismatching hash is 'tampered' and never loadable.",
      "type": "object",
      "required": ["sha256"],
      "additionalProperties": false,
      "properties": {
        "algo": { "type": "string", "enum": ["sha256"] },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "provenance": {
      "description": "wq#4056: where the payload came from (SLSA-lite predicate). source must equal [source].canonical when both are present; commit is the git commit the payload was built from (the fake REA 6.3.0 release archive matched no commit — this field is what makes that checkable).",
      "type": "object",
      "required": ["source", "commit"],
      "additionalProperties": false,
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "build": { "type": "string", "enum": ["git-clone", "release-archive", "local-build"] },
        "builder": { "type": "string" },
        "fetched_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}" }
      }
    },
    "signature": {
      "description": "wq#4056: detached Ed25519 (minisign-scheme) signature over the manifest bytes; covers the payload transitively via integrity.sha256. key_id is pinned per plugin name on first install (TOFU-pin); core/vetted tiers require signer=org.",
      "type": "object",
      "required": ["scheme", "key_id", "signer", "file"],
      "additionalProperties": false,
      "properties": {
        "scheme": { "type": "string", "enum": ["minisign"] },
        "key_id": { "type": "string", "minLength": 1 },
        "signer": { "type": "string", "enum": ["maintainer", "org"] },
        "file": { "type": "string", "minLength": 1 }
      }
    },
    "hardware": {
      "description": "Present only for hardware plugins (category=hardware). Mirrors the VISION.md [hardware]/[detection]/[agent_use] blocks.",
      "type": "object",
      "required": ["type", "detection"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "video-capture",
            "debug-probe",
            "logic-analyzer",
            "sdr",
            "programmer",
            "accelerator",
            "usb-target"
          ]
        },
        "detection": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "usb_vendor": { "type": "string", "pattern": "^[0-9a-fA-F]{1,4}$" },
            "usb_product": { "type": "string", "pattern": "^[0-9a-fA-F]{1,4}$" },
            "device_path": { "type": "string" },
            "driver": { "type": "string" }
          }
        },
        "agent_use": {
          "type": "object",
          "additionalProperties": { "type": "boolean" }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "plugin": { "properties": { "category": { "const": "hardware" } } } }
      },
      "then": { "required": ["hardware"] }
    }
  ]
}
