{
  "name": "limpet",
  "version": 1,
  "source": "docs/branding-spec.md",
  "modes": {
    "dark": {
      "background": "#0C1414",
      "surface": "#152221",
      "panel": "#1C2B2A",
      "foreground": "#D6E2DF",
      "muted": "#7A8C8A",
      "primary": "#3EC5F0",
      "secondary": "#D9A441",
      "accent": "#5FA876",
      "success": "#5FA876",
      "warning": "#E5B35A",
      "error": "#E06C6C"
    },
    "light": {
      "background": "#F7F5EF",
      "surface": "#ECE9E0",
      "panel": "#E2DED2",
      "foreground": "#1A2423",
      "muted": "#4F5E5C",
      "primary": "#0A6E9B",
      "secondary": "#8A6114",
      "accent": "#2E6E4C",
      "success": "#2E6E4C",
      "warning": "#8A6114",
      "error": "#B03A3A"
    }
  },
  "ansi16_fallback": {
    "foreground": "white",
    "muted": "bright_black",
    "primary": "bright_cyan",
    "secondary": "yellow",
    "accent": "green",
    "success": "green",
    "warning": "bright_yellow",
    "error": "bright_red"
  },
  "typography": {
    "mono": {
      "family": "JetBrains Mono",
      "debian_package": "fonts-jetbrains-mono",
      "fallback": "DejaVu Sans Mono, monospace"
    },
    "ui": {
      "family": "Inter",
      "debian_package": "fonts-inter",
      "fallback": "DejaVu Sans, sans-serif"
    }
  }
}
