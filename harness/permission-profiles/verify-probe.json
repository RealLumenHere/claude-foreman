      "Bash(gh pr checks*)",
      "Bash(gh run view*)",
      "Bash(gh run list*)",
      "Bash(gh issue view*)",
      "Bash(gh issue list*)",
      "mcp__docker__list_containers",
      "mcp__docker__list_images",
      "mcp__docker__list_networks",
      "mcp__docker__list_volumes",
      "mcp__docker__fetch_container_logs",
      "mcp__keenable__search_web_pages",
      "mcp__keenable__fetch_page_content"
    ],
    "deny": [
      "Bash(*reboot*)",
      "Bash(shutdown*)",
      "Bash(poweroff*)",
      "Bash(halt*)",
      "Bash(systemctl stop*)",
      "Bash(systemctl disable*)",
