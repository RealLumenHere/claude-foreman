  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "/home/lumen/foreman/harness/guard.sh"
          }
        ]
      },
      {
        "matcher": "Bash|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /home/lumen/foreman/harness/action_gate.py hook"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/lumen/foreman/harness/guard.sh --lifecycle start"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/lumen/foreman/harness/guard.sh --lifecycle stop"
          },
          {
            "type": "command",
            "command": "python3 /home/lumen/foreman/harness/hooks/stop_gate.py"
          }
        ]
      }
    ],
    "SessionEnd": [
