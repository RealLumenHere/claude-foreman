      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(diff *)",
      "Bash(echo *)",
      "Bash(printf *)",
      "Bash(test *)",
      "Bash(true)",
      "Bash(basename *)",
      "Bash(dirname *)",
      "Bash(systemctl status*)",
      "Bash(systemctl is-active*)",
      "Bash(systemctl is-enabled*)",
      "Bash(systemctl show*)",
      "Bash(systemctl list-*)",
      "Bash(systemctl cat*)",
      "Bash(journalctl *)",
      "Bash(stat *)",
      "Bash(readlink *)",
      "Bash(realpath *)",
      "Bash(ps)",
      "Bash(ps -p *)",
      "Bash(jq *)",
      "Bash(cut *)",
      "Bash(tr *)",
      "Bash(nl *)",
      "Bash(which *)",
      "Bash(uname*)",
      "Bash(hostname*)",
      "Bash(date*)",
      "Bash(df *)",
      "Bash(ss *)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
