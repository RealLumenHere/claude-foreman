# lumen-despag.env.example — template for lumen-despag.service's EnvironmentFile.
#
# Operator setup (wq#1887 P2-1 — this worker does not run the privileged steps):
#   cp harness/systemd/lumen-despag.env.example /home/lumen/.secrets/lumen-despag.env
#   chmod 600 /home/lumen/.secrets/lumen-despag.env
#   # fill in real values below, then create the paths it points at:
#   install -d -m 700 /home/lumen/despag-data          # DESPAG_DATA_DIR
#   install -d -m 700 -o lumen -g lumen $(dirname <token path>)
#   <write the real token to DESPAG_API_TOKEN_FILE, then> chmod 600 <token path>
#
# Placeholder values only below — never commit real tokens or paths outside the
# despag-data/worktrees roots the unit's ReadWritePaths carves out.

# Path to the bearer token despag requires on every route except GET /v1/uhp
# (despag/app.py _load_or_create_token — created 0600 with a random token if the file
# doesn't exist yet; an EXISTING file is only read, never chmod-ed, wq#1931, so create it
# 0600 yourself). Never put the token value itself in this file (instinct 4).
DESPAG_API_TOKEN_FILE=/home/lumen/.secrets/despag-api.token

# Root for despag's own state: control.db (idempotency reserve + session leases,
# despag/app.py:106-107), scratch-repo, spool. Must fall inside restic coverage —
# see harness/systemd/lumen-despag.env.example's sibling note in the PR body:
# services/backup/scripts/backup-critical.sh's PATHS_TO_BACKUP could not be read
# from this worker's sandbox (ISSUE-LOG #360, #375) to confirm/extend coverage.
DESPAG_DATA_DIR=/home/lumen/despag-data

# Upper bound on concurrent `claude -p` children across all sessions
# (despag/admission.py:86), independent of the burn-rate-derived allowance.
DESPAG_MAX_CLAUDE_CONCURRENT=8

# Wall-clock cap per turn, in seconds (despag/runner/turn.py:81, default 21600 =
# 6h if unset). A turn still running past this is force-stopped and mapped to
# UHP status "incomplete" (despag/app.py:190).
DESPAG_MAX_TURN_SECONDS=21600

# Port despag's uvicorn server listens on, loopback-only (despag/__main__.py:31-32
# hardcodes host=127.0.0.1 regardless of this file).
DESPAG_PORT=8790

# Workspace root for conformance-harness sessions (despag/workspace.py:88-92,
# default /home/lumen/worktrees/despag). Must stay under the unit's
# ReadWritePaths=/home/lumen/worktrees entry (harness/systemd/lumen-despag.service)
# or ProtectHome=read-only will refuse every workspace write.
DESPAG_WORKTREES_ROOT=/home/lumen/worktrees/despag
